############
############
+ parse_dimse_status struct.error path

= parse_dimse_status returns None when struct.unpack fails
# Construct bytes where the length field overruns the buffer in middle of iteration
# The function tries to read elements; we feed it a header that promises a long
# group length but the inner elements have garbage that can't unpack as <HH or <I
# This is tricky - simulate via group_len=20, then element with absurd value_len
hdr = struct.pack("<HHI", 0x0000, 0x0000, 4) + struct.pack("<I", 12)
# Now feed a single element with tag (0x0008, 0x0000) and absurd length
bad_elem = struct.pack("<HH", 0x0008, 0x0000) + struct.pack("<I", 0xFFFFFFFF)
buf = hdr + bad_elem
# Iterating, status not found and offset jumps past end
assert parse_dimse_status(buf) is None

############
############
+ DICOMSocket _parse_max_pdu_length edge cases

= _parse_max_pdu_length handles AC with no Maximum Length sub-item
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
sock._proposed_max_pdu = 16384
# Build A-ASSOCIATE-AC with UserInfo containing only ImplClassUID, no MaxLength
impl_item = DICOMVariableItem() / DICOMImplementationClassUID(uid=b"1.2.3.4")
user_info = DICOMVariableItem() / DICOMUserInformation(sub_items=[impl_item])
ac = DICOM() / A_ASSOCIATE_AC(
    called_ae_title=b"ANY",
    calling_ae_title=b"SRC",
    variable_items=[user_info],
)
ac = DICOM(bytes(ac))
sock._parse_max_pdu_length(ac)
# Falls back to proposed
assert sock.max_pdu_length == 16384

= _parse_max_pdu_length handles non-UserInfo items in variable_items
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
sock._proposed_max_pdu = 16384
# A-ASSOCIATE-AC with ApplicationContext (non-UserInfo) before UserInfo
app_ctx = DICOMVariableItem() / DICOMApplicationContext()
max_len_item = DICOMVariableItem() / DICOMMaximumLength(max_pdu_length=2048)
user_info = DICOMVariableItem() / DICOMUserInformation(sub_items=[max_len_item])
ac = DICOM() / A_ASSOCIATE_AC(
    called_ae_title=b"ANY",
    calling_ae_title=b"SRC",
    variable_items=[app_ctx, user_info],
)
ac = DICOM(bytes(ac))
sock._parse_max_pdu_length(ac)
assert sock.max_pdu_length == 2048

= _parse_max_pdu_length swallows KeyError from missing layer
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
sock._proposed_max_pdu = 4096
# Pass an A-ASSOCIATE-RJ where A_ASSOCIATE_AC layer is missing
rj = DICOM() / A_ASSOCIATE_RJ()
# Should not raise - exception is caught internally and falls back to proposed
sock._parse_max_pdu_length(rj)
assert sock.max_pdu_length == 4096

############
############
+ DICOMSocket _parse_accepted_contexts edge cases

= _parse_accepted_contexts skips non-PresentationContext items
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
sock._proposed_context_map = {1: VERIFICATION_SOP_CLASS_UID}
# AC with only ApplicationContext - no presentation contexts
app_ctx = DICOMVariableItem() / DICOMApplicationContext()
ac = DICOM() / A_ASSOCIATE_AC(
    called_ae_title=b"ANY",
    calling_ae_title=b"SRC",
    variable_items=[app_ctx],
)
ac = DICOM(bytes(ac))
sock._parse_accepted_contexts(ac)
assert len(sock.accepted_contexts) == 0

= _parse_accepted_contexts handles PresentationContextAC with non-TransferSyntax sub_items
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
sock._proposed_context_map = {1: VERIFICATION_SOP_CLASS_UID}
# Build PresentationContextAC where sub_items contains a non-transfer-syntax item
# Use AbstractSyntax (0x30) instead of TransferSyntax (0x40)
abs_syn = DICOMVariableItem() / DICOMAbstractSyntax(uid=b"1.2.3")
pctx = DICOMVariableItem() / DICOMPresentationContextAC(
    context_id=1, result=0, sub_items=[abs_syn]
)
ac = DICOM() / A_ASSOCIATE_AC(
    called_ae_title=b"ANY",
    calling_ae_title=b"SRC",
    variable_items=[pctx],
)
ac = DICOM(bytes(ac))
sock._parse_accepted_contexts(ac)
# No transfer syntax found, so context not recorded
assert 1 not in sock.accepted_contexts

############
############
+ DICOMSocket I/O methods with mock stream

= DICOMSocket send/recv/sr1/send_raw_bytes use the underlying stream
from io import BytesIO

# Build a fake stream that captures sent bytes and returns canned recv data
class _FakeSock:
    def __init__(self, recv_data=b""):
        self._sent = b""
        self._recv = recv_data
    def sendall(self, data):
        self._sent += data
    def send(self, data):
        self._sent += data
        return len(data)
    def recv(self, n):
        out, self._recv = self._recv[:n], self._recv[n:]
        return out
    def close(self):
        pass

class _FakeStream:
    def __init__(self):
        self.sent = []
        self.recv_responses = []
        self.closed = False
    def send(self, pkt):
        self.sent.append(bytes(pkt))
    def recv(self):
        if self.recv_responses:
            return self.recv_responses.pop(0)
        return None
    def sr1(self, pkt, timeout=None, **kwargs):
        self.sent.append(bytes(pkt))
        if self.recv_responses:
            return self.recv_responses.pop(0)
        return None
    def close(self):
        self.closed = True

sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
fake = _FakeStream()
sock.stream = fake
sock.sock = _FakeSock()
# Test send
pkt = DICOM() / A_RELEASE_RQ()
sock.send(pkt)
assert len(fake.sent) == 1
assert fake.sent[0] == bytes(pkt)
# Test recv - no canned response returns None
assert sock.recv() is None
# Queue a response
fake.recv_responses.append(DICOM() / A_RELEASE_RP())
result = sock.recv()
assert result.haslayer(A_RELEASE_RP)
# Test sr1 - sends and receives
fake.recv_responses.append(DICOM() / A_RELEASE_RP())
result = sock.sr1(DICOM() / A_RELEASE_RQ())
assert result.haslayer(A_RELEASE_RP)
# Test send_raw_bytes
sock.send_raw_bytes(b"raw_bytes_payload")
assert b"raw_bytes_payload" in sock.sock._sent
# Test close
sock.close()
assert fake.closed
assert sock.sock is None
assert sock.stream is None

= DICOMSocket close handles stream.close() socket.error
import socket as _stdsocket

class _BrokenStream:
    def close(self):
        raise _stdsocket.error("simulated close failure")

sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
sock.stream = _BrokenStream()
sock.sock = _FakeSock()
# Should not raise
sock.close()
assert sock.stream is None

= DICOMSocket recv handles socket.timeout
class _TimeoutStream:
    def recv(self):
        raise _stdsocket.timeout()
    def close(self):
        pass

sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
sock.stream = _TimeoutStream()
assert sock.recv() is None

= DICOMSocket recv handles socket.error
class _ErrorStream:
    def recv(self):
        raise _stdsocket.error("simulated recv failure")
    def close(self):
        pass

sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
sock.stream = _ErrorStream()
assert sock.recv() is None

= DICOMSocket sr1 handles socket.error
class _SR1ErrorStream:
    def sr1(self, pkt, timeout=None, **kwargs):
        raise _stdsocket.error("sr1 failure")
    def close(self):
        pass

sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
sock.stream = _SR1ErrorStream()
assert sock.sr1(DICOM() / A_RELEASE_RQ()) is None

############
############
+ DICOMSocket associate with mock stream

= associate succeeds when fake stream returns A_ASSOCIATE_AC
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE", src_ae="SCAPY_SCU")
# Build a fake AC response with accepted context and max length
ts = DICOMVariableItem() / DICOMTransferSyntax(
    uid=_uid_to_bytes(DEFAULT_TRANSFER_SYNTAX_UID)
)
pctx = DICOMVariableItem() / DICOMPresentationContextAC(
    context_id=1, result=0, sub_items=[ts]
)
max_len_item = DICOMVariableItem() / DICOMMaximumLength(max_pdu_length=4096)
user_info = DICOMVariableItem() / DICOMUserInformation(sub_items=[max_len_item])
ac = DICOM() / A_ASSOCIATE_AC(
    called_ae_title=b"DEST_AE",
    calling_ae_title=b"SCAPY_SCU",
    variable_items=[pctx, user_info],
)
ac = DICOM(bytes(ac))

fake = _FakeStream()
fake.recv_responses.append(ac)
sock.stream = fake
sock.sock = _FakeSock()

result = sock.associate()
assert result is True
assert sock.assoc_established is True
assert 1 in sock.accepted_contexts
assert sock.max_pdu_length == 4096

= associate fails when fake stream returns A_ASSOCIATE_RJ
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE", src_ae="SCAPY_SCU")
rj = DICOM() / A_ASSOCIATE_RJ(result=1, source=1, reason_diag=1)
rj = DICOM(bytes(rj))
fake = _FakeStream()
fake.recv_responses.append(rj)
sock.stream = fake
sock.sock = _FakeSock()
result = sock.associate()
assert result is False
assert sock.assoc_established is False

= associate fails when no response from fake stream
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
fake = _FakeStream()  # no canned responses
sock.stream = fake
sock.sock = _FakeSock()
result = sock.associate()
assert result is False
assert sock.assoc_established is False

= associate with custom requested_contexts
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE", src_ae="SCAPY_SCU")
ts = DICOMVariableItem() / DICOMTransferSyntax(
    uid=_uid_to_bytes(DEFAULT_TRANSFER_SYNTAX_UID)
)
pctx = DICOMVariableItem() / DICOMPresentationContextAC(
    context_id=1, result=0, sub_items=[ts]
)
ac = DICOM() / A_ASSOCIATE_AC(
    called_ae_title=b"DEST_AE",
    calling_ae_title=b"SCAPY_SCU",
    variable_items=[pctx],
)
ac = DICOM(bytes(ac))
fake = _FakeStream()
fake.recv_responses.append(ac)
sock.stream = fake
sock.sock = _FakeSock()
custom_contexts = {
    CT_IMAGE_STORAGE_SOP_CLASS_UID: [DEFAULT_TRANSFER_SYNTAX_UID],
    MR_IMAGE_STORAGE_SOP_CLASS_UID: [DEFAULT_TRANSFER_SYNTAX_UID],
}
result = sock.associate(requested_contexts=custom_contexts)
assert result is True
# Two contexts should have been proposed
assert len(sock._proposed_context_map) == 2

