ac = A_ASSOCIATE_AC()
assert ac.answers(rq) == True
assert ac.answers(A_RELEASE_RQ()) == False

= A-ASSOCIATE-RJ answers A-ASSOCIATE-RQ
rq = A_ASSOCIATE_RQ()
rj = A_ASSOCIATE_RJ()
