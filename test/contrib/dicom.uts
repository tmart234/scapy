% DICOM (Digital Imaging and Communications in Medicine) tests

# Type the following command to launch the tests:
# $ test/run_tests -P "load_contrib('dicom')" -t test/contrib/dicom.uts

############
############
+ DICOM module loading

= Import DICOM module
load_contrib("dicom", globals_dict=globals())

= Verify essential classes are exported
assert DICOM is not None
assert A_ASSOCIATE_RQ is not None
assert A_ASSOCIATE_AC is not None
assert A_ASSOCIATE_RJ is not None
assert P_DATA_TF is not None
assert A_RELEASE_RQ is not None
assert A_RELEASE_RP is not None
assert A_ABORT is not None
assert DICOMVariableItem is not None
assert DICOMApplicationContext is not None
assert DICOMPresentationContextRQ is not None
assert DICOMUserInformation is not None
assert DICOMMaximumLength is not None

= Verify DIMSE packet classes are exported
assert C_ECHO_RQ is not None
assert C_ECHO_RSP is not None
assert C_STORE_RQ is not None
assert C_STORE_RSP is not None
assert C_FIND_RQ is not None
assert C_FIND_RSP is not None
assert C_MOVE_RQ is not None
assert C_MOVE_RSP is not None
assert C_GET_RQ is not None
assert C_GET_RSP is not None

= Verify C-CANCEL and DIMSE-N packet classes are exported
assert C_CANCEL_RQ is not None
assert N_EVENT_REPORT_RQ is not None
assert N_EVENT_REPORT_RSP is not None
assert N_GET_RQ is not None
assert N_GET_RSP is not None
assert N_SET_RQ is not None
assert N_SET_RSP is not None
assert N_ACTION_RQ is not None
assert N_ACTION_RSP is not None
assert N_CREATE_RQ is not None
assert N_CREATE_RSP is not None
assert N_DELETE_RQ is not None
assert N_DELETE_RSP is not None

= Verify constants are exported
assert DICOM_PORT == 104
assert APP_CONTEXT_UID == "1.2.840.10008.3.1.1.1"
assert DEFAULT_TRANSFER_SYNTAX_UID == "1.2.840.10008.1.2"
assert VERIFICATION_SOP_CLASS_UID == "1.2.840.10008.1.1"

= Verify Query/Retrieve SOP Class UIDs are exported
assert PATIENT_ROOT_QR_FIND_SOP_CLASS_UID == "1.2.840.10008.5.1.4.1.2.1.1"
assert PATIENT_ROOT_QR_MOVE_SOP_CLASS_UID == "1.2.840.10008.5.1.4.1.2.1.2"
assert PATIENT_ROOT_QR_GET_SOP_CLASS_UID == "1.2.840.10008.5.1.4.1.2.1.3"
assert STUDY_ROOT_QR_FIND_SOP_CLASS_UID == "1.2.840.10008.5.1.4.1.2.2.1"
assert STUDY_ROOT_QR_MOVE_SOP_CLASS_UID == "1.2.840.10008.5.1.4.1.2.2.2"
assert STUDY_ROOT_QR_GET_SOP_CLASS_UID == "1.2.840.10008.5.1.4.1.2.2.3"
assert MODALITY_WORKLIST_FIND_SOP_CLASS_UID == "1.2.840.10008.5.1.4.31"

= Verify Transfer Syntax and Storage SOP Class UIDs are exported
assert IMPLICIT_VR_LITTLE_ENDIAN_UID == DEFAULT_TRANSFER_SYNTAX_UID
assert EXPLICIT_VR_LITTLE_ENDIAN_UID == "1.2.840.10008.1.2.1"
assert JPEG_BASELINE_UID == "1.2.840.10008.1.2.4.50"
assert HTJ2K_UID == "1.2.840.10008.1.2.4.203"
assert MR_IMAGE_STORAGE_SOP_CLASS_UID == "1.2.840.10008.5.1.4.1.1.4"
assert SECONDARY_CAPTURE_SOP_CLASS_UID == "1.2.840.10008.5.1.4.1.1.7"
assert DIMSE_STATUS_CODES[0x0122] == "Refused: SOP class not supported"

############
############
+ PDU header tests

= DICOM PDU header construction
pkt = DICOM()
assert pkt.pdu_type == 0x01
assert pkt.reserved1 == 0

= DICOM PDU type field values
import struct
for pdu_type, expected_class in [(0x01, A_ASSOCIATE_RQ), (0x02, A_ASSOCIATE_AC),
                                  (0x03, A_ASSOCIATE_RJ), (0x04, P_DATA_TF),
                                  (0x05, A_RELEASE_RQ), (0x06, A_RELEASE_RP),
                                  (0x07, A_ABORT)]:
    pkt = DICOM() / expected_class()
    raw_bytes = bytes(pkt)
    assert raw_bytes[0] == pdu_type

############
############
+ LenField auto-calculation tests

= DICOM header auto-calculates payload length
pkt = DICOM() / A_RELEASE_RQ()
raw = bytes(pkt)
length_field = struct.unpack("!I", raw[2:6])[0]
payload_size = len(raw) - 6
assert length_field == payload_size
assert length_field == 4

= Variable item length auto-calculated
pkt = DICOMVariableItem() / DICOMApplicationContext()
raw = bytes(pkt)
length_field = struct.unpack("!H", raw[2:4])[0]
payload_size = len(raw) - 4
assert length_field == payload_size

= Nested items have correct cumulative length
max_len = DICOMVariableItem() / DICOMMaximumLength(max_pdu_length=16384)
user_info = DICOMVariableItem() / DICOMUserInformation(sub_items=[max_len])
raw = bytes(user_info)
assert len(raw) == 12
ui_length = struct.unpack("!H", raw[2:4])[0]
assert ui_length == 8

############
############
+ Variable item bind_layers tests

= Application Context bind_layers (type 0x10)
pkt = DICOMVariableItem() / DICOMApplicationContext()
assert pkt.item_type == 0x10
raw = bytes(pkt)
parsed = DICOMVariableItem(raw)
assert parsed.item_type == 0x10
assert parsed.haslayer(DICOMApplicationContext)

= Abstract Syntax bind_layers (type 0x30)
uid = _uid_to_bytes(VERIFICATION_SOP_CLASS_UID)
pkt = DICOMVariableItem() / DICOMAbstractSyntax(uid=uid)
assert pkt.item_type == 0x30
raw = bytes(pkt)
parsed = DICOMVariableItem(raw)
assert parsed.item_type == 0x30
assert parsed.haslayer(DICOMAbstractSyntax)
assert parsed[DICOMAbstractSyntax].uid == uid

= Transfer Syntax bind_layers (type 0x40)
pkt = DICOMVariableItem() / DICOMTransferSyntax()
assert pkt.item_type == 0x40
raw = bytes(pkt)
parsed = DICOMVariableItem(raw)
assert parsed.item_type == 0x40
assert parsed.haslayer(DICOMTransferSyntax)

= Maximum Length bind_layers (type 0x51)
pkt = DICOMVariableItem() / DICOMMaximumLength(max_pdu_length=32768)
assert pkt.item_type == 0x51
raw = bytes(pkt)
parsed = DICOMVariableItem(raw)
assert parsed.item_type == 0x51
assert parsed.haslayer(DICOMMaximumLength)
assert parsed[DICOMMaximumLength].max_pdu_length == 32768

= User Information bind_layers (type 0x50)
max_len = DICOMVariableItem() / DICOMMaximumLength(max_pdu_length=16384)
pkt = DICOMVariableItem() / DICOMUserInformation(sub_items=[max_len])
assert pkt.item_type == 0x50
raw = bytes(pkt)
parsed = DICOMVariableItem(raw)
assert parsed.item_type == 0x50
assert parsed.haslayer(DICOMUserInformation)

= Presentation Context RQ bind_layers (type 0x20)
abs_syn = DICOMVariableItem() / DICOMAbstractSyntax(uid=_uid_to_bytes(VERIFICATION_SOP_CLASS_UID))
ts = DICOMVariableItem() / DICOMTransferSyntax()
pkt = DICOMVariableItem() / DICOMPresentationContextRQ(context_id=1, sub_items=[abs_syn, ts])
assert pkt.item_type == 0x20
raw = bytes(pkt)
parsed = DICOMVariableItem(raw)
assert parsed.item_type == 0x20
assert parsed.haslayer(DICOMPresentationContextRQ)
assert parsed[DICOMPresentationContextRQ].context_id == 1

= Presentation Context AC bind_layers (type 0x21)
ts = DICOMVariableItem() / DICOMTransferSyntax()
pkt = DICOMVariableItem() / DICOMPresentationContextAC(context_id=1, result=0, sub_items=[ts])
assert pkt.item_type == 0x21
raw = bytes(pkt)
parsed = DICOMVariableItem(raw)
assert parsed.item_type == 0x21
assert parsed.haslayer(DICOMPresentationContextAC)
assert parsed[DICOMPresentationContextAC].result == 0

= Unknown item type falls back to DICOMGenericItem
raw = struct.pack("!BBH", 0xFF, 0, 4) + b"test"
parsed = DICOMVariableItem(raw)
assert parsed.item_type == 0xFF
assert parsed.length == 4
assert parsed[DICOMGenericItem].data == b"test"

= Non-ASCII UID does not break the summary
parsed = DICOMVariableItem(struct.pack("!BBH", 0x30, 0, 4) + b"\xff1.2")
assert parsed.summary() == "DICOMVariableItem / AbstractSyntax \\xff1.2"

############
############
+ A-ASSOCIATE-RQ tests

= Build simple A-ASSOCIATE-RQ
app_ctx = DICOMVariableItem() / DICOMApplicationContext()
pctx = build_presentation_context_rq(1, VERIFICATION_SOP_CLASS_UID, [DEFAULT_TRANSFER_SYNTAX_UID])
user_info = build_user_information(max_pdu_length=16384)
assoc_rq = DICOM() / A_ASSOCIATE_RQ(
    called_ae_title=b"TARGET",
    calling_ae_title=b"SOURCE",
    variable_items=[app_ctx, pctx, user_info]
)
raw = bytes(assoc_rq)
parsed = DICOM(raw)
assert parsed.haslayer(A_ASSOCIATE_RQ)
items = parsed[A_ASSOCIATE_RQ].variable_items
assert len(items) == 3
assert items[0].item_type == 0x10
assert items[1].item_type == 0x20
assert items[2].item_type == 0x50

= A-ASSOCIATE-RQ AE titles are space-padded by DICOMAETitleField
original = DICOM() / A_ASSOCIATE_RQ(
    called_ae_title=b"TARGET",
    calling_ae_title=b"SOURCE",
)
serialized = bytes(original)
parsed = DICOM(serialized)
assert parsed.haslayer(A_ASSOCIATE_RQ)
assert parsed[A_ASSOCIATE_RQ].called_ae_title == b"TARGET          "
assert parsed[A_ASSOCIATE_RQ].calling_ae_title == b"SOURCE          "

= A-ASSOCIATE-RQ with multiple presentation contexts
app_ctx = DICOMVariableItem() / DICOMApplicationContext()
pctx1 = build_presentation_context_rq(1, VERIFICATION_SOP_CLASS_UID, [DEFAULT_TRANSFER_SYNTAX_UID])
pctx2 = build_presentation_context_rq(3, CT_IMAGE_STORAGE_SOP_CLASS_UID, [DEFAULT_TRANSFER_SYNTAX_UID])
user_info = build_user_information()
assoc_rq = DICOM() / A_ASSOCIATE_RQ(
    called_ae_title=b"TARGET",
    calling_ae_title=b"SOURCE",
    variable_items=[app_ctx, pctx1, pctx2, user_info]
)
raw = bytes(assoc_rq)
parsed = DICOM(raw)
items = parsed[A_ASSOCIATE_RQ].variable_items
assert len(items) == 4
pctx_items = [i for i in items if i.item_type == 0x20]
assert len(pctx_items) == 2
assert pctx_items[0][DICOMPresentationContextRQ].context_id == 1
assert pctx_items[1][DICOMPresentationContextRQ].context_id == 3

= A-ASSOCIATE-AC and A-ASSOCIATE-RJ answer an A-ASSOCIATE-RQ
rq = DICOM() / A_ASSOCIATE_RQ(called_ae_title="SERVER", calling_ae_title="SCAPY_SCU")
ac = DICOM(bytes(DICOM() / A_ASSOCIATE_AC(called_ae_title="SERVER", calling_ae_title="SCAPY_SCU")))
rj = DICOM(bytes(DICOM() / A_ASSOCIATE_RJ()))
assert ac.hashret() == rq.hashret()
assert ac.answers(rq)
assert rj.hashret() == rq.hashret()
assert rj.answers(rq)

############
############
+ A-ASSOCIATE-RJ tests

= A-ASSOCIATE-RJ construction and parsing
pkt = DICOM() / A_ASSOCIATE_RJ(result=1, source=2, reason_diag=2)
reparsed = DICOM(bytes(pkt))
assert reparsed.haslayer(A_ASSOCIATE_RJ)
assert reparsed[A_ASSOCIATE_RJ].source == 2

= A-ASSOCIATE-RJ reason depends on the source
pkt = DICOM(bytes(DICOM() / A_ASSOCIATE_RJ(source=1, reason_diag=7)))
assert pkt.sprintf("%A_ASSOCIATE_RJ.reason_diag%") == "called-AE-title-not-recognized"
pkt = DICOM(bytes(DICOM() / A_ASSOCIATE_RJ(source=3, reason_diag=1)))
assert pkt.sprintf("%A_ASSOCIATE_RJ.reason_diag%") == "temporary-congestion"
pkt = A_ASSOCIATE_RJ(source=2, reason_diag="protocol-version-not-supported")
assert pkt.reason_diag == 2

############
############
+ A-RELEASE tests

= A-RELEASE-RQ round-trip
original = DICOM() / A_RELEASE_RQ()
serialized = bytes(original)
parsed = DICOM(serialized)
assert parsed.haslayer(A_RELEASE_RQ)

= A-RELEASE-RP round-trip
original = DICOM() / A_RELEASE_RP()
serialized = bytes(original)
parsed = DICOM(serialized)
assert parsed.haslayer(A_RELEASE_RP)

############
############
+ A-ABORT tests

= A-ABORT round-trip
original = DICOM() / A_ABORT(source=2, reason_diag=6)
serialized = bytes(original)
parsed = DICOM(serialized)
assert parsed.haslayer(A_ABORT)
assert parsed[A_ABORT].source == 2
assert parsed[A_ABORT].reason_diag == 6
assert parsed.sprintf("%A_ABORT.reason_diag%") == "invalid-PDU-parameter-value"

= A-ABORT reason is not named for a service-user abort
pkt = DICOM(bytes(DICOM() / A_ABORT(source=0, reason_diag=1)))
assert pkt.sprintf("%A_ABORT.reason_diag%") == "1"

############
############
+ P-DATA-TF tests

= PresentationDataValueItem length linked to data
test_data = b"TEST_DATA_12345"
pdv = PresentationDataValueItem(context_id=1, data=test_data, is_command=1, is_last=1)
raw = bytes(pdv)
length = struct.unpack("!I", raw[:4])[0]
assert length == len(test_data) + 2

= P-DATA-TF with multiple PDV items - build only
pdv1 = PresentationDataValueItem(context_id=1, data=b'\xDE\xAD', is_command=1, is_last=0)
pdv2 = PresentationDataValueItem(context_id=1, data=b'\xBE\xEF', is_command=0, is_last=1)
pkt = DICOM() / P_DATA_TF(pdv_items=[pdv1, pdv2])
raw = bytes(pkt)
assert raw[0] == 0x04
assert len(raw) > 6

= P-DATA-TF round-trip - build and verify structure
test_data = b"\x01\x02\x03\x04\x05"
pdv = PresentationDataValueItem(context_id=3, data=test_data, is_command=1, is_last=1)
original = DICOM() / P_DATA_TF(pdv_items=[pdv])
serialized = bytes(original)
assert serialized[0] == 0x04
length = struct.unpack("!I", serialized[2:6])[0]
assert length > 0
assert test_data in serialized

= PDV is_command flag encoding
pdv = PresentationDataValueItem(context_id=1, data=b'x', is_command=1, is_last=0)
raw = bytes(pdv)
msg_ctrl = raw[5]
assert msg_ctrl & 0x01 == 1
assert msg_ctrl & 0x02 == 0

= PDV is_last flag encoding
pdv = PresentationDataValueItem(context_id=1, data=b'x', is_command=0, is_last=1)
raw = bytes(pdv)
msg_ctrl = raw[5]
assert msg_ctrl & 0x01 == 0
assert msg_ctrl & 0x02 == 2

= PDV both flags set
pdv = PresentationDataValueItem(context_id=1, data=b'x', is_command=1, is_last=1)
raw = bytes(pdv)
msg_ctrl = raw[5]
assert msg_ctrl == 0x03

= PDV flags encoding verification
for is_cmd in [0, 1]:
    for is_last in [0, 1]:
        pdv = PresentationDataValueItem(context_id=1, data=b'test', is_command=is_cmd, is_last=is_last)
        raw = bytes(pdv)
        msg_ctrl = raw[5]
        assert (msg_ctrl & 0x01) == is_cmd
        assert (msg_ctrl & 0x02) == (is_last << 1)

############
############
+ DIMSE packet tests

= C_ECHO_RQ creation with defaults
pkt = C_ECHO_RQ()
raw = bytes(pkt)
assert raw[:4] == b'\x00\x00\x00\x00'
assert b'1.2.840.10008.1.1' in raw

= C_ECHO_RQ custom message_id
pkt = C_ECHO_RQ(message_id=12345)
raw = bytes(pkt)
assert b'\x10\x01' in raw
assert struct.pack("<H", 12345) in raw

= C_ECHO_RSP creation
pkt = C_ECHO_RSP(message_id_responded=42, status=0x0000)
raw = bytes(pkt)
assert struct.pack("<H", 0x8030) in raw
assert b'\x00\x09' in raw

= C_STORE_RQ creation
pkt = C_STORE_RQ(
    affected_sop_class_uid=CT_IMAGE_STORAGE_SOP_CLASS_UID,
    affected_sop_instance_uid="1.2.3.4.5.6.7.8.9",
    message_id=100,
)
raw = bytes(pkt)
assert b'1.2.840.10008.5.1.4.1.1.2' in raw
assert b'1.2.3.4.5.6.7.8.9' in raw
assert struct.pack("<H", 0x0001) in raw

= C_FIND_RQ creation
pkt = C_FIND_RQ(message_id=55)
raw = bytes(pkt)
assert struct.pack("<H", 0x0020) in raw

= C_FIND_RSP creation
pkt = C_FIND_RSP(message_id_responded=55, status=0x0000)
raw = bytes(pkt)
assert struct.pack("<H", 0x8020) in raw
assert struct.pack("<H", 0x0000) in raw

= C_MOVE_RQ creation with move_destination
pkt = C_MOVE_RQ(message_id=100, move_destination=b"DEST_AE")
raw = bytes(pkt)
assert struct.pack("<H", 0x0021) in raw
assert b'DEST_AE' in raw

= C_MOVE_RQ elements are in ascending tag order
raw = bytes(C_MOVE_RQ(move_destination=b"DEST_AE"))
assert raw.index(b"\x00\x00\x00\x06") < raw.index(b"\x00\x00\x00\x07")
parsed = C_MOVE_RQ(raw)
assert parsed.move_destination == b"DEST_AE         "
assert parsed.priority == 0x0002

= C_MOVE_RSP creation with sub-operation counters
pkt = C_MOVE_RSP(
    message_id_responded=100,
    status=0xFF00,
    num_remaining=5,
    num_completed=3,
    num_failed=1,
    num_warning=0
)
raw = bytes(pkt)
assert struct.pack("<H", 0x8021) in raw
assert struct.pack("<H", 0xFF00) in raw

= C_GET_RQ creation
pkt = C_GET_RQ(message_id=200)
raw = bytes(pkt)
assert struct.pack("<H", 0x0010) in raw

= C_GET_RSP creation with sub-operation counters
pkt = C_GET_RSP(
    message_id_responded=200,
    status=0x0000,
    num_remaining=0,
    num_completed=10,
    num_failed=0,
    num_warning=0
)
raw = bytes(pkt)
assert struct.pack("<H", 0x8010) in raw

= DIMSE command in P-DATA-TF - build verification
dimse = C_ECHO_RQ(message_id=42)
pdv = PresentationDataValueItem(context_id=1, data=bytes(dimse), is_command=1, is_last=1)
pdata = DICOM() / P_DATA_TF(pdv_items=[pdv])
raw = bytes(pdata)
assert raw[0] == 0x04
assert b'1.2.840.10008.1.1' in raw

= DIMSE command round-trip with Command Group Length
raw = bytes(C_ECHO_RSP(message_id_responded=42, status=0x0122))
assert raw[:8] == b"\x00\x00\x00\x00\x04\x00\x00\x00"
parsed = C_ECHO_RSP(raw)
assert parsed.command_group_length == len(raw) - 12
assert parsed.affected_sop_class_uid == b"1.2.840.10008.1.1\x00"
assert parsed.command_field == 0x8030
assert parsed.message_id_responded == 42
assert parsed.status == 0x0122
assert bytes(parsed) == raw

= DIMSEPacket dispatches on the Command Field
for cls in DIMSEPacket.__subclasses__():
    raw = bytes(cls())
    parsed = DIMSEPacket(raw)
    assert isinstance(parsed, cls)
    assert bytes(parsed) == raw

parsed = DIMSEPacket(bytes(C_GET_RSP(status=0xFF00, num_remaining=3)))
assert isinstance(parsed, C_GET_RSP)
assert parsed.num_remaining == 3
assert type(DIMSEPacket(b"\x00" * 8)) is DIMSEPacket

= C_STORE_RQ Move Originator elements are optional
raw = bytes(C_STORE_RQ())
assert b"\x00\x00\x30\x10" not in raw
parsed = C_STORE_RQ(raw)
assert parsed.move_originator_ae_title is None
assert parsed.move_originator_message_id is None
raw = bytes(C_STORE_RQ(move_originator_ae_title=b"MOVE_SCU", move_originator_message_id=7))
parsed = C_STORE_RQ(raw)
assert parsed.move_originator_ae_title == b"MOVE_SCU        "
assert parsed.move_originator_message_id == 7
assert not parsed.payload

= C_CANCEL_RQ round-trip
raw = bytes(C_CANCEL_RQ(message_id_responded=12))
parsed = C_CANCEL_RQ(raw)
assert parsed.command_field == 0x0FFF
assert parsed.message_id_responded == 12
assert parsed.summary() == "C-CANCEL-RQ msg_id=0x000C"

= DIMSE-N commands round-trip
pkt = N_EVENT_REPORT_RQ(affected_sop_class_uid="1.2.3", event_type_id=2)
assert N_EVENT_REPORT_RQ(bytes(pkt)).event_type_id == 2
pkt = N_ACTION_RQ(requested_sop_instance_uid="1.2.3.4", action_type_id=1)
parsed = N_ACTION_RQ(bytes(pkt))
assert parsed.requested_sop_instance_uid == b"1.2.3.4\x00"
assert parsed.action_type_id == 1
rq = N_SET_RQ(message_id=5)
rsp = N_SET_RSP(bytes(N_SET_RSP(message_id_responded=5, status=0x0106)))
assert rsp.status == 0x0106
assert rsp.answers(rq)
assert rsp.hashret() == rq.hashret()
for cls in [N_CREATE_RSP, N_DELETE_RSP, N_EVENT_REPORT_RSP, N_GET_RSP]:
    assert cls(bytes(cls(status=0x0112))).status == 0x0112

= DIMSE responses with status-related elements
raw = bytes(C_STORE_RSP(status=0xA700, error_comment=b"Out of resources",
                        affected_sop_instance_uid="1.2.3.4"))
parsed = C_STORE_RSP(raw)
assert parsed.error_comment == b"Out of resources"
assert parsed.affected_sop_instance_uid == b"1.2.3.4\x00"
assert not parsed.payload
raw = bytes(C_FIND_RSP(status=0xC000, offending_element=[(0x0008, 0x0052)]))
assert C_FIND_RSP(raw).offending_element == [(0x0008, 0x0052)]
raw = bytes(N_SET_RSP(status=0x0107, error_id=3, attribute_identifier_list=[(0x0010, 0x0010)]))
parsed = N_SET_RSP(raw)
assert parsed.error_id == 3
assert parsed.attribute_identifier_list == [(0x0010, 0x0010)]
assert not parsed.payload

= N_GET_RQ Attribute Identifier List
pkt = N_GET_RQ(attribute_identifier_list=[(0x0010, 0x0010), (0x0010, 0x0020)])
raw = bytes(pkt)
element = struct.pack("<HHI", 0x0000, 0x1005, 8) + struct.pack("<4H", 0x10, 0x10, 0x10, 0x20)
assert element in raw
assert N_GET_RQ(raw).attribute_identifier_list == [(0x0010, 0x0010), (0x0010, 0x0020)]
assert N_GET_RQ(bytes(N_GET_RQ())).attribute_identifier_list is None

= parse_dimse_status reads the Status element
assert parse_dimse_status(bytes(C_STORE_RSP(status=0xA700))) == 0xA700
assert parse_dimse_status(bytes(C_ECHO_RQ())) is None
assert parse_dimse_status(b"\x00" * 4) is None

############
############
+ Helper function tests

= build_presentation_context_rq creates proper structure
pctx = build_presentation_context_rq(
    context_id=3,
    abstract_syntax_uid=VERIFICATION_SOP_CLASS_UID,
    transfer_syntax_uids=[DEFAULT_TRANSFER_SYNTAX_UID]
)
assert pctx.item_type == 0x20
assert pctx.haslayer(DICOMPresentationContextRQ)
assert pctx[DICOMPresentationContextRQ].context_id == 3
sub_items = pctx[DICOMPresentationContextRQ].sub_items
assert len(sub_items) == 2
assert sub_items[0].item_type == 0x30
assert sub_items[1].item_type == 0x40

= UIDs in association items are not padded
pctx = build_presentation_context_rq(1, VERIFICATION_SOP_CLASS_UID, [DEFAULT_TRANSFER_SYNTAX_UID])
sub_items = DICOMVariableItem(bytes(pctx))[DICOMPresentationContextRQ].sub_items
assert sub_items[0].uid == b"1.2.840.10008.1.1"
assert sub_items[1].uid == b"1.2.840.10008.1.2"
assert DICOMApplicationContext().uid == b"1.2.840.10008.3.1.1.1"
user_info = build_user_information(implementation_class_uid="1.2.3")
assert user_info[DICOMImplementationClassUID].uid == b"1.2.3"

= build_user_information creates proper structure
user_info = build_user_information(max_pdu_length=32768)
assert user_info.item_type == 0x50
assert user_info.haslayer(DICOMUserInformation)
sub_items = user_info[DICOMUserInformation].sub_items
assert len(sub_items) >= 1
assert sub_items[0].item_type == 0x51
assert sub_items[0][DICOMMaximumLength].max_pdu_length == 32768

= zero maximum PDU length means unlimited
maximum = DICOMVariableItem() / DICOMMaximumLength(max_pdu_length=0)
user_info = DICOMVariableItem() / DICOMUserInformation(sub_items=[maximum])
response = DICOM() / A_ASSOCIATE_AC(variable_items=[user_info])
client = DICOM_Client("127.0.0.1", 104, "SERVER")
client._parse_max_pdu_length(DICOM(bytes(response)))
assert client.max_pdu_length == client._proposed_max_pdu
assert maximum.summary() == "DICOMVariableItem / MaxLength unlimited"

= DICOM_Client association, C-ECHO, C-STORE and release with a peer
import socket
import threading
from scapy.supersocket import StreamSocket

def answer(stream, context_id, command):
    pdv = PresentationDataValueItem(context_id=context_id, data=bytes(command),
                                    is_command=1, is_last=1)
    stream.send(DICOM() / P_DATA_TF(pdv_items=[pdv]))

def peer_scp(sock, received):
    stream = StreamSocket(sock, basecls=DICOM)
    received.append(stream.recv())
    contexts = [
        DICOMVariableItem() / DICOMPresentationContextAC(
            context_id=context_id, sub_items=[DICOMVariableItem() / DICOMTransferSyntax()]
        )
        for context_id in (1, 3)
    ]
    # Odd maximum length: the fragments must stay even
    user_info = build_user_information(max_pdu_length=1025)
    stream.send(DICOM() / A_ASSOCIATE_AC(variable_items=contexts + [user_info]))
    received.append(stream.recv())
    message_id = DIMSEPacket(received[-1][PresentationDataValueItem].data).message_id
    # A response to another request comes first
    answer(stream, 1, C_ECHO_RSP(message_id_responded=message_id - 1, status=0x0110))
    answer(stream, 1, C_ECHO_RSP(message_id_responded=message_id))
    while True:
        received.append(stream.recv())
        pdv = received[-1][PresentationDataValueItem]
        if pdv.is_last and not pdv.is_command:
            break
    message_id = DIMSEPacket(received[2][PresentationDataValueItem].data).message_id
    answer(stream, 3, C_STORE_RSP(message_id_responded=message_id - 1, status=0xA700))
    answer(stream, 3, C_STORE_RSP(message_id_responded=message_id, status=0xB000))
    received.append(stream.recv())
    stream.send(DICOM() / A_RELEASE_RP())

client, peer = socket.socketpair()
client.settimeout(5)
peer.settimeout(5)
received = []
thread = threading.Thread(target=peer_scp, args=(peer, received))
thread.daemon = True
thread.start()
dicom_client = DICOM_Client("127.0.0.1", 104, "SERVER", read_timeout=5)
dicom_client.sock = client
dicom_client.stream = StreamSocket(client, basecls=DICOM)
dicom_client.accepted_contexts = {5: ("1.2.3", DEFAULT_TRANSFER_SYNTAX_UID)}
contexts = {
    VERIFICATION_SOP_CLASS_UID: [DEFAULT_TRANSFER_SYNTAX_UID],
    CT_IMAGE_STORAGE_SOP_CLASS_UID: [DEFAULT_TRANSFER_SYNTAX_UID],
}
try:
    associated = dicom_client.associate(contexts)
    echo_status = dicom_client.c_echo()
    store_status = dicom_client.c_store(b"D" * 3000, CT_IMAGE_STORAGE_SOP_CLASS_UID,
                                      "1.2.3.4", DEFAULT_TRANSFER_SYNTAX_UID)
    released = dicom_client.release()
finally:
    thread.join(5)
    dicom_client.close()
    peer.close()

assert associated
assert sorted(dicom_client.accepted_contexts) == [1, 3]
assert dicom_client.max_pdu_length == 1025
assert echo_status == 0x0000
assert store_status == 0xB000
assert released
assert received[0].haslayer(A_ASSOCIATE_RQ)
assert isinstance(DIMSEPacket(received[1][PresentationDataValueItem].data), C_ECHO_RQ)
assert isinstance(DIMSEPacket(received[2][PresentationDataValueItem].data), C_STORE_RQ)
data_pdus = received[3:-1]
assert len(data_pdus) == 3
assert [len(pdu[PresentationDataValueItem].data) for pdu in data_pdus] == [1018, 1018, 964]
assert all(pdu.length <= 1025 for pdu in data_pdus)
assert b"".join(pdu[PresentationDataValueItem].data for pdu in data_pdus) == b"D" * 3000
assert received[-1].haslayer(A_RELEASE_RQ)

= DICOM_Client refuses a too small maximum PDU length
dicom_client = DICOM_Client("127.0.0.1", 104, "SERVER")
dicom_client.assoc_established = True
dicom_client.accepted_contexts = {1: (CT_IMAGE_STORAGE_SOP_CLASS_UID, DEFAULT_TRANSFER_SYNTAX_UID)}
dicom_client.max_pdu_length = 7
assert dicom_client.c_store(b"D" * 10, CT_IMAGE_STORAGE_SOP_CLASS_UID, "1.2.3",
                          DEFAULT_TRANSFER_SYNTAX_UID) is None

= build_user_information with implementation info
user_info = build_user_information(
    max_pdu_length=16384,
    implementation_class_uid="1.2.3.4.5",
    implementation_version="SCAPY_V1"
)
sub_items = user_info[DICOMUserInformation].sub_items
assert len(sub_items) == 3
types = [item.item_type for item in sub_items]
assert 0x51 in types
assert 0x52 in types
assert 0x55 in types
assert sub_items[2].version_name == b"SCAPY_V1"
assert sub_items[2].summary() == "DICOMVariableItem / ImplVersion SCAPY_V1"

= build_user_information with role selection and user identity
user_info = build_user_information(
    roles={CT_IMAGE_STORAGE_SOP_CLASS_UID: (0, 1)},
    user_identity=DICOMUserIdentity(user_identity_type=2, primary_field=b"user",
                                    secondary_field=b"pass"),
)
parsed = DICOMVariableItem(bytes(user_info))
sub_items = parsed[DICOMUserInformation].sub_items
assert [item.item_type for item in sub_items] == [0x51, 0x54, 0x58]
assert sub_items[1].sop_class_uid == b"1.2.840.10008.5.1.4.1.1.2"
assert sub_items[1].scu_role == 0
assert sub_items[1].scp_role == 1
assert sub_items[2].secondary_field == b"pass"

= User Information with a role selection per presentation context
roles = {"1.2.840.10008.5.1.4.1.1.%d" % i: (0, 1) for i in range(120)}
parsed = DICOMVariableItem(bytes(build_user_information(roles=roles)))
assert len(parsed[DICOMUserInformation].sub_items) == 121
assert parsed[DICOMUserInformation].sub_items[-1].scp_role == 1

= _uid_to_bytes pads odd-length UIDs
assert len(_uid_to_bytes("1.2.3")) % 2 == 0
assert _uid_to_bytes("1.2.3.4") == b"1.2.3.4\x00"
assert _uid_to_bytes("1.2.3") == b"1.2.3\x00"

############
############
+ DICOM_Server

= DICOM_Server negotiates the presentation contexts and the roles
def associate_rq(called_ae_title="SCAPY_SCP", app_context=APP_CONTEXT_UID,
                 protocol_version=1):
    return DICOM(bytes(DICOM() / A_ASSOCIATE_RQ(
        protocol_version=protocol_version,
        called_ae_title=called_ae_title,
        calling_ae_title="SCU",
        variable_items=[
            DICOMVariableItem() / DICOMApplicationContext(uid=app_context),
            build_presentation_context_rq(1, VERIFICATION_SOP_CLASS_UID,
                                          [EXPLICIT_VR_LITTLE_ENDIAN_UID,
                                           DEFAULT_TRANSFER_SYNTAX_UID]),
            build_presentation_context_rq(3, CT_IMAGE_STORAGE_SOP_CLASS_UID,
                                          [JPEG_BASELINE_UID]),
            build_presentation_context_rq(5, PATIENT_ROOT_QR_FIND_SOP_CLASS_UID,
                                          [DEFAULT_TRANSFER_SYNTAX_UID]),
            build_user_information(roles={CT_IMAGE_STORAGE_SOP_CLASS_UID: (1, 1)}),
        ],
    )))

server = DICOM_Server()
ac = DICOM(bytes(server.make_reply(associate_rq())))
assert server.assoc_established
assert ac.called_ae_title == b"SCAPY_SCP       "
assert ac.calling_ae_title == b"SCU             "
contexts = [item for item in ac.variable_items if item.item_type == 0x21]
assert [(item.context_id, item.result) for item in contexts] == [(1, 0), (3, 4), (5, 3)]
assert contexts[0].sub_items[0].uid == DEFAULT_TRANSFER_SYNTAX_UID.encode()
assert server.accepted_contexts == {
    1: (VERIFICATION_SOP_CLASS_UID, DEFAULT_TRANSFER_SYNTAX_UID)
}
sub_items = ac[DICOMUserInformation].sub_items
assert sub_items[0].max_pdu_length == 16384
assert sub_items[1].uid == DICOM_IMPLEMENTATION_CLASS_UID.encode()
# The requestor may be SCU, but not SCP, unless accepted
assert (sub_items[2].scu_role, sub_items[2].scp_role) == (1, 0)
server = DICOM_Server(roles={CT_IMAGE_STORAGE_SOP_CLASS_UID: (1, 1)})
ac = server.make_reply(associate_rq())
role = ac[DICOMUserInformation].sub_items[2]
assert (role.scu_role, role.scp_role) == (1, 1)
assert server.peer_max_pdu_length == 16384
# The UID of a role is sent back as received
rq = DICOM(bytes(DICOM() / A_ASSOCIATE_RQ(variable_items=[
    DICOMVariableItem() / DICOMApplicationContext(),
    build_user_information(roles={b"1.2.\xc3\xa9": (1, 1)}),
])))
ac = DICOM_Server().make_reply(rq)
assert ac[DICOMSCPSCURoleSelection].sop_class_uid == b"1.2.\xc3\xa9"

= DICOM_Server accepts any presentation context with accept_context()
class AnyServer(DICOM_Server):
    def accept_context(self, abstract_syntax, transfer_syntaxes):
        return 0, transfer_syntaxes[0]

server = AnyServer()
ac = server.make_reply(associate_rq())
assert server.accepted_contexts == {
    1: (VERIFICATION_SOP_CLASS_UID, EXPLICIT_VR_LITTLE_ENDIAN_UID),
    3: (CT_IMAGE_STORAGE_SOP_CLASS_UID, JPEG_BASELINE_UID),
    5: (PATIENT_ROOT_QR_FIND_SOP_CLASS_UID, DEFAULT_TRANSFER_SYNTAX_UID),
}

= DICOM_Server rejects associations
server = DICOM_Server(ae_title="SCAPY_SCP")
for request, rejection in [
    (associate_rq(called_ae_title="OTHER"), (1, 1, 7)),
    (associate_rq(app_context="1.2.3"), (1, 1, 2)),
    (associate_rq(protocol_version=2), (1, 2, 2)),
]:
    rj = server.make_reply(request)[A_ASSOCIATE_RJ]
    assert (rj.result, rj.source, rj.reason_diag) == rejection
    assert not server.assoc_established

= DICOM_Server aborts on unexpected PDUs
def p_data(context_id, command):
    pdv = PresentationDataValueItem(context_id=context_id, data=bytes(command),
                                    is_command=1, is_last=1)
    return DICOM(bytes(DICOM() / P_DATA_TF(pdv_items=[pdv])))

server = DICOM_Server()
# Before the association: A-ABORT from the service-user (AA-1)
abort = server.make_reply(p_data(1, C_ECHO_RQ()))[A_ABORT]
assert (abort.source, abort.reason_diag) == (0, 0)
assert server.make_reply(DICOM(bytes(DICOM() / A_ABORT()))) is None
# No PDU during read_timeout: A-ABORT once associated
assert server.make_reply(None) is None
ac = server.make_reply(associate_rq())
assert server.make_reply(None).haslayer(A_ABORT)
for pdu, reason in [
    (DICOM(b"\x09\x00\x00\x00\x00\x02\x00\x00"), 1),
    (associate_rq(), 2),
    (p_data(3, C_ECHO_RQ()), 6),
    (p_data(1, bytes(C_ECHO_RQ(message_id=1))[:-1]), 6),
    # PDV item length of 0
    (DICOM(b"\x04\x00\x00\x00\x00\x04\x00\x00\x00\x00"), 6),
]:
    ac = server.make_reply(associate_rq())
    abort = server.make_reply(pdu)[A_ABORT]
    assert (abort.source, abort.reason_diag) == (2, reason)
    assert not server.assoc_established

= DICOM_Client and DICOM_Server on a socket pair
import socket
import threading
from scapy.supersocket import StreamSocket

stored = []
def store_handler(request, transfer_syntax_uid, dataset):
    stored.append((request.affected_sop_instance_uid, transfer_syntax_uid, dataset))
    return 0xB000

client, peer = socket.socketpair()
client.settimeout(5)
server = DICOM_Server(ae_title="SCAPY_SCP", store_handler=store_handler,
                      max_pdu_length=1025, read_timeout=5)
thread = threading.Thread(target=server.handle, args=(peer,))
thread.daemon = True
thread.start()
dicom_client = DICOM_Client("127.0.0.1", 104, "SCAPY_SCP", read_timeout=5)
dicom_client.sock = client
dicom_client.stream = StreamSocket(client, basecls=DICOM)
try:
    associated = dicom_client.associate({
        VERIFICATION_SOP_CLASS_UID: [DEFAULT_TRANSFER_SYNTAX_UID],
        CT_IMAGE_STORAGE_SOP_CLASS_UID: [DEFAULT_TRANSFER_SYNTAX_UID],
    })
    echo_status = dicom_client.c_echo()
    store_status = dicom_client.c_store(b"D" * 3000, CT_IMAGE_STORAGE_SOP_CLASS_UID,
                                        "1.2.3.4", DEFAULT_TRANSFER_SYNTAX_UID)
    # Requests without SCP get the status Unrecognized operation
    find_rq = C_FIND_RQ(affected_sop_class_uid=STUDY_ROOT_QR_FIND_SOP_CLASS_UID,
                        message_id=9)
    find_rq = PresentationDataValueItem(context_id=1, is_command=1, is_last=1,
                                        data=bytes(find_rq))
    identifier = PresentationDataValueItem(context_id=1, data=b"I" * 10, is_last=1)
    find_rsp = dicom_client.sr1(DICOM() / P_DATA_TF(pdv_items=[find_rq, identifier]))
    released = dicom_client.release()
finally:
    thread.join(5)
    dicom_client.close()

assert associated
assert dicom_client.max_pdu_length == 1025
assert echo_status == 0x0000
assert store_status == 0xB000
assert stored == [(b"1.2.3.4\x00", DEFAULT_TRANSFER_SYNTAX_UID, b"D" * 3000)]
command = DIMSEPacket(find_rsp[PresentationDataValueItem].data)
assert isinstance(command, C_FIND_RSP)
assert (command.message_id_responded, command.status) == (9, 0x0211)
assert plain_str(command.affected_sop_class_uid).rstrip("\x00") == STUDY_ROOT_QR_FIND_SOP_CLASS_UID
assert released
assert not thread.is_alive()

= DICOM_Server sends the PDUs of its hooks, even incorrect ones
class RogueServer(DICOM_Server):
    def negotiate(self, pdu):
        # Maximum Length sub-item of 6 bytes instead of 4
        ac = super(RogueServer, self).negotiate(pdu)
        ac[DICOMUserInformation].sub_items[0] = (
            DICOMVariableItem() / DICOMMaximumLength(max_pdu_length=1024)
            / Raw(b"\x00\x00")
        )
        return bytes(ac)
    def dimse_reply(self, request, context_id, dataset):
        # No C-ECHO-RSP
        return None

client, peer = socket.socketpair()
client.settimeout(5)
thread = threading.Thread(target=RogueServer(read_timeout=5).handle, args=(peer,))
thread.daemon = True
thread.start()
dicom_client = DICOM_Client("127.0.0.1", 104, "SCAPY_SCP", read_timeout=1)
dicom_client.sock = client
dicom_client.stream = StreamSocket(client, basecls=DICOM)
try:
    associated = dicom_client.associate()
    echo_status = dicom_client.c_echo()
    # Raw bytes reach the server as they are: unknown PDU type
    dicom_client.send_raw_bytes(b"\x09\x00\x00\x00\x00\x00")
    abort = dicom_client.recv()
finally:
    dicom_client.close()
    thread.join(5)

assert not thread.is_alive()
assert associated
assert dicom_client.max_pdu_length == 1024
assert echo_status is None
assert abort[A_ABORT].reason_diag == 1

= DICOM_Server as Storage SCU of a C-GET, DICOM_Client as Storage SCP
class GetServer(DICOM_Server):
    def dimse_reply(self, request, context_id, dataset):
        if not isinstance(request, C_GET_RQ):
            return super(GetServer, self).dimse_reply(request, context_id, dataset)
        # C-STORE sub-operation on the context of the Storage SOP Class
        store_rq = C_STORE_RQ(affected_sop_class_uid=CT_IMAGE_STORAGE_SOP_CLASS_UID,
                              affected_sop_instance_uid="1.2.3.5", message_id=1)
        for pdu in dicom_build_p_data_tf(3, store_rq, b"G" * 20000,
                                         self.peer_max_pdu_length):
            self.stream.send(pdu)
        store_rsp = DIMSEPacket(self.stream.recv()[PresentationDataValueItem].data)
        return C_GET_RSP(affected_sop_class_uid=request.affected_sop_class_uid,
                         message_id_responded=request.message_id,
                         num_remaining=0, num_completed=1, num_failed=0,
                         num_warning=0, status=store_rsp.status)

client, peer = socket.socketpair()
client.settimeout(5)
server = GetServer(
    supported_contexts={
        PATIENT_ROOT_QR_GET_SOP_CLASS_UID: [DEFAULT_TRANSFER_SYNTAX_UID],
        CT_IMAGE_STORAGE_SOP_CLASS_UID: [DEFAULT_TRANSFER_SYNTAX_UID],
    },
    roles={CT_IMAGE_STORAGE_SOP_CLASS_UID: (0, 1)},
    read_timeout=5,
)
thread = threading.Thread(target=server.handle, args=(peer,))
thread.daemon = True
thread.start()
dicom_client = DICOM_Client("127.0.0.1", 104, "SCAPY_SCP", read_timeout=5)
dicom_client.sock = client
dicom_client.stream = StreamSocket(client, basecls=DICOM)
try:
    associated = dicom_client.associate(
        {
            PATIENT_ROOT_QR_GET_SOP_CLASS_UID: [DEFAULT_TRANSFER_SYNTAX_UID],
            CT_IMAGE_STORAGE_SOP_CLASS_UID: [DEFAULT_TRANSFER_SYNTAX_UID],
        },
        roles={CT_IMAGE_STORAGE_SOP_CLASS_UID: (0, 1)},
    )
    get_rq = C_GET_RQ(affected_sop_class_uid=PATIENT_ROOT_QR_GET_SOP_CLASS_UID,
                      message_id=7)
    dicom_client.send(p_data(1, get_rq))
    pdv = PresentationDataValueItem(context_id=1, data=b"Q" * 10, is_last=1)
    dicom_client.send(DICOM() / P_DATA_TF(pdv_items=[pdv]))
    store_rq = DIMSEPacket(dicom_client.recv()[PresentationDataValueItem].data)
    store_data = b""
    while True:
        pdv = dicom_client.recv()[PresentationDataValueItem]
        store_data += pdv.data
        if pdv.is_last:
            break
    store_rsp = C_STORE_RSP(affected_sop_class_uid=store_rq.affected_sop_class_uid,
                            affected_sop_instance_uid=store_rq.affected_sop_instance_uid,
                            message_id_responded=store_rq.message_id)
    dicom_client.send(p_data(3, store_rsp))
    get_rsp = DIMSEPacket(dicom_client.recv()[PresentationDataValueItem].data)
    released = dicom_client.release()
finally:
    thread.join(5)
    dicom_client.close()

assert associated
assert isinstance(store_rq, C_STORE_RQ)
assert store_data == b"G" * 20000
assert isinstance(get_rsp, C_GET_RSP)
assert (get_rsp.message_id_responded, get_rsp.num_completed, get_rsp.status) == (7, 1, 0)
assert released

= DICOM_Server awaits the end of the connection after a release
client, peer = socket.socketpair()
client.settimeout(5)
thread = threading.Thread(target=DICOM_Server(read_timeout=5).handle, args=(peer,))
thread.daemon = True
thread.start()
stream = StreamSocket(client, basecls=DICOM)
try:
    ac = stream.sr1(associate_rq(), timeout=5, verbose=False)
    rp = stream.sr1(DICOM() / A_RELEASE_RQ(), timeout=5, verbose=False)
    # Sta13: a P-DATA-TF is ignored (AA-6), an A-ASSOCIATE-RQ aborted (AA-7)
    stream.send(p_data(1, C_ECHO_RQ()))
    stream.send(associate_rq())
    abort = stream.recv()
finally:
    stream.close()
    thread.join(5)

assert ac.haslayer(A_ASSOCIATE_AC)
assert rp.haslayer(A_RELEASE_RP)
assert (abort[A_ABORT].source, abort[A_ABORT].reason_diag) == (2, 2)
assert not thread.is_alive()

= DICOM_Client and DICOM_Server over TLS
import ssl
from scapy.supersocket import SSLStreamSocket
server_context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
server_context.load_cert_chain(scapy_path("/test/scapy/layers/tls/pki/srv_cert.pem"),
                               scapy_path("/test/scapy/layers/tls/pki/srv_key.pem"))
client_context = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
client_context.check_hostname = False
client_context.verify_mode = ssl.CERT_NONE
client, peer = socket.socketpair()
client.settimeout(5)
peer.settimeout(5)
server = DICOM_Server(read_timeout=5)
thread = threading.Thread(
    target=lambda: server.handle(server_context.wrap_socket(peer, server_side=True))
)
thread.daemon = True
thread.start()
tls_client = client_context.wrap_socket(client)
dicom_client = DICOM_Client("127.0.0.1", 2762, "SCAPY_SCP", read_timeout=5)
dicom_client.sock = tls_client
dicom_client.stream = SSLStreamSocket(tls_client, basecls=DICOM)
try:
    associated = dicom_client.associate()
    echo_status = dicom_client.c_echo()
    released = dicom_client.release()
finally:
    dicom_client.close()
    thread.join(5)

assert associated
assert echo_status == 0x0000
assert released

= dicom_build_p_data_tf fragments a DIMSE message
command = C_STORE_RQ(message_id=1)
pdus = [DICOM(bytes(pdu)) for pdu in
        dicom_build_p_data_tf(3, command, b"D" * 25, max_pdu_length=17)]
pdvs = [pdu[PresentationDataValueItem] for pdu in pdus]
assert bytes(command) == b"".join(pdv.data for pdv in pdvs if pdv.is_command)
assert [len(pdv.data) for pdv in pdvs if not pdv.is_command] == [10, 10, 5]
assert all(pdu.length <= 17 and pdv.context_id == 3 for pdu, pdv in zip(pdus, pdvs))
assert [pdv.is_last for pdv in pdvs if not pdv.is_command] == [0, 0, 1]
assert len(list(dicom_build_p_data_tf(1, command, b"D" * 25, max_pdu_length=0))) == 2
pdus = list(dicom_build_p_data_tf(1, command, b""))
assert [(pdu.is_command, pdu.is_last, pdu.data) for pdu in
        (p[PresentationDataValueItem] for p in pdus)][1] == (0, 1, b"")

= DICOM_Server.spawn on the loopback address
server_socket = DICOM_Server.spawn(port=0, local_ip="127.0.0.1", bg=True,
                                   ae_title="SCAPY_SCP")
host, port = server_socket.getsockname()
try:
    with DICOM_Client(host, port, "SCAPY_SCP", read_timeout=5) as dicom_client:
        associated = dicom_client.associate()
        echo_status = dicom_client.c_echo()
finally:
    try:
        server_socket.shutdown(socket.SHUT_RDWR)
    except OSError:
        pass
    server_socket.close()

assert associated
assert echo_status == 0x0000

############
############
+ User Identity Negotiation tests

= User Identity username only (type 1)
pkt = DICOMVariableItem() / DICOMUserIdentity(
    user_identity_type=1,
    positive_response_requested=0,
    primary_field=b"admin"
)
assert pkt.item_type == 0x58
raw = bytes(pkt)
parsed = DICOMVariableItem(raw)
assert parsed.haslayer(DICOMUserIdentity)
assert parsed[DICOMUserIdentity].user_identity_type == 1
assert parsed[DICOMUserIdentity].primary_field == b"admin"
assert parsed[DICOMUserIdentity].secondary_field_length == 0
assert raw.endswith(b"admin\x00\x00")

= User Identity username+password (type 2)
pkt = DICOMVariableItem() / DICOMUserIdentity(
    user_identity_type=2,
    positive_response_requested=1,
    primary_field=b"admin",
    secondary_field=b"password123"
)
raw = bytes(pkt)
parsed = DICOMVariableItem(raw)
assert parsed.haslayer(DICOMUserIdentity)
assert parsed[DICOMUserIdentity].user_identity_type == 2
assert parsed[DICOMUserIdentity].primary_field == b"admin"
assert parsed[DICOMUserIdentity].secondary_field == b"password123"

= User Identity Response
pkt = DICOMVariableItem() / DICOMUserIdentityResponse(
    server_response=b"auth_token_12345"
)
assert pkt.item_type == 0x59
raw = bytes(pkt)
parsed = DICOMVariableItem(raw)
assert parsed.haslayer(DICOMUserIdentityResponse)
assert parsed[DICOMUserIdentityResponse].server_response == b"auth_token_12345"

