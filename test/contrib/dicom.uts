############
############
+ DIMSE packet hashret methods

= C_ECHO_RQ hashret returns packed message_id
pkt = C_ECHO_RQ(message_id=0x1234)
assert pkt.hashret() == struct.pack("<H", 0x1234)

= C_ECHO_RSP hashret returns packed message_id_responded
pkt = C_ECHO_RSP(message_id_responded=0x5678)
assert pkt.hashret() == struct.pack("<H", 0x5678)

