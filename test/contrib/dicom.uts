############
+ UID conversion helper edge cases

= _uid_to_bytes handles bytes, even-length and unsupported input
assert _uid_to_bytes(b"1.2.3") == b"1.2.3\x00"
assert _uid_to_bytes("1.2.3.4") == b"1.2.3.4\x00"
assert _uid_to_bytes(b"1234") == b"1234"
assert _uid_to_bytes(None) == b""
assert _uid_to_bytes(123) == b""

= _uid_to_bytes_raw never pads and handles unsupported input
assert _uid_to_bytes_raw("1.2.3") == b"1.2.3"
assert _uid_to_bytes_raw(b"1.2.3") == b"1.2.3"
assert _uid_to_bytes_raw(None) == b""
assert _uid_to_bytes_raw(123) == b""

############
############
+ Custom DICOM field round-trip tests

= DICOMUSField getfield round-trip and short-buffer fallback
fld = DICOMUSField("t", 0, 0x0010, 0x0020)
remain, val = fld.getfield(None, fld.addfield(None, b"", 0x1234))
assert val == 0x1234 and remain == b""
remain, val = fld.getfield(None, struct.pack("<HHI", 0x0010, 0x0020, 1) + b"\x42")
assert val == 0
assert fld.i2repr(None, 0x1234) == "0x1234"

= DICOMULField getfield round-trip and short-buffer fallback
fld = DICOMULField("t", 0, 0x0010, 0x0020)
remain, val = fld.getfield(None, fld.addfield(None, b"", 0xDEADBEEF))
assert val == 0xDEADBEEF and remain == b""
remain, val = fld.getfield(None, struct.pack("<HHI", 0x0010, 0x0020, 2) + b"\x42\x43")
assert val == 0

= DICOMElementField i2repr and getfield branches
fld = DICOMElementField("t", b"", 0x0010, 0x0020)
assert fld.i2repr(None, b"VALUE\x00") == "VALUE"
assert fld.i2repr(None, b"\xff\xfe\xfd") == "fffefd"
assert fld.i2repr(None, 42) == "42"
remain, val = fld.getfield(None, b"\x00\x00\x00")
assert val == b"" and remain == b"\x00\x00\x00"

= DICOMElementField getfield raises on truncated value
fld = DICOMElementField("t", b"", 0x0010, 0x0020)
malformed = struct.pack("<HHI", 0x0010, 0x0020, 100) + b"abcd"
try:
    fld.getfield(None, malformed)
    assert False
except Scapy_Exception:
    pass

= DICOMUIDField and DICOMUIDFieldRaw addfield branches
uf = DICOMUIDField("t", b"", 0x0010, 0x0020)
assert uf.addfield(None, b"", b"") == struct.pack("<HHI", 0x0010, 0x0020, 0)
assert uf.i2repr(None, "1.2.3") == "1.2.3"
raw = DICOMUIDFieldRaw("t", b"", 0x0010, 0x0020)
assert raw.addfield(None, b"", "1.2.3") == struct.pack("<HHI", 0x0010, 0x0020, 5) + b"1.2.3"

= DICOMAEDIMSEField addfield and i2repr branches
fld = DICOMAEDIMSEField("t", b"", 0x0000, 0x0600)
assert fld.addfield(None, b"", None) == struct.pack("<HHI", 0x0000, 0x0600, 16) + b" " * 16
assert fld.addfield(None, b"", "DEST") == struct.pack("<HHI", 0x0000, 0x0600, 16) + b"DEST".ljust(16, b" ")
assert fld.i2repr(None, b"DEST            ") == "DEST"
assert fld.i2repr(None, "DEST    ") == "DEST"

= DICOMATField addfield/getfield branches
fld = DICOMATField("t", [], 0x0000, 0x1005)
assert fld.addfield(None, b"", None) == struct.pack("<HHI", 0x0000, 0x1005, 0)
single_int = fld.addfield(None, b"", 0x00100010)
assert single_int == struct.pack("<HHI", 0x0000, 0x1005, 4) + struct.pack("<HH", 0x0010, 0x0010)
remain, tags = fld.getfield(None, single_int)
assert tags == [(0x0010, 0x0010)] and remain == b""
assert fld.randval() == []

= DICOMAETitleField i2m and i2repr branches
fld = DICOMAETitleField("ae")
assert fld.i2m(None, None) == b" " * 16
assert fld.i2m(None, "SCAPY") == b"SCAPY".ljust(16, b" ")
assert fld.i2m(None, "A" * 32) == b"A" * 16
assert fld.i2repr(None, b"SCU             ") == "SCU"
assert fld.i2repr(None, "ABC   ") == "ABC"

############
############
+ DIMSE packet mysummary / hashret / answers coverage

= All DIMSE request packets expose mysummary and hashret
rq_classes = [C_ECHO_RQ, C_STORE_RQ, C_FIND_RQ, C_MOVE_RQ, C_GET_RQ,
              N_EVENT_REPORT_RQ, N_GET_RQ, N_SET_RQ, N_ACTION_RQ,
              N_CREATE_RQ, N_DELETE_RQ]
for cls in rq_classes:
    pkt = cls(message_id=0x1234)
    assert isinstance(pkt.mysummary(), str)
    assert pkt.hashret() == struct.pack("<H", 0x1234)

= All DIMSE response packets expose mysummary and hashret
rsp_classes = [C_ECHO_RSP, C_STORE_RSP, C_FIND_RSP, C_MOVE_RSP, C_GET_RSP,
               N_EVENT_REPORT_RSP, N_GET_RSP, N_SET_RSP, N_ACTION_RSP,
               N_CREATE_RSP, N_DELETE_RSP]
for cls in rsp_classes:
    pkt = cls(message_id_responded=0x4321)
    assert isinstance(pkt.mysummary(), str)
    assert pkt.hashret() == struct.pack("<H", 0x4321)

= C_CANCEL_RQ mysummary
assert "C-CANCEL-RQ" in C_CANCEL_RQ(message_id_being_responded_to=5).mysummary()

= DIMSE response answers matching and non-matching requests
pairs = [(C_ECHO_RSP, C_ECHO_RQ), (C_STORE_RSP, C_STORE_RQ),
         (C_FIND_RSP, C_FIND_RQ), (C_MOVE_RSP, C_MOVE_RQ),
         (C_GET_RSP, C_GET_RQ), (N_EVENT_REPORT_RSP, N_EVENT_REPORT_RQ),
         (N_GET_RSP, N_GET_RQ), (N_SET_RSP, N_SET_RQ),
         (N_ACTION_RSP, N_ACTION_RQ), (N_CREATE_RSP, N_CREATE_RQ),
         (N_DELETE_RSP, N_DELETE_RQ)]
for rsp_cls, rq_cls in pairs:
    assert rsp_cls(message_id_responded=7).answers(rq_cls(message_id=7)) == True
    assert rsp_cls(message_id_responded=7).answers(rq_cls(message_id=9)) == False
    assert rsp_cls(message_id_responded=7).answers(A_RELEASE_RQ()) == 0

