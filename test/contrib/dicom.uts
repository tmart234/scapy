assert sock._get_next_message_id() == 101
sock._current_message_id_counter = 0xFFFF
assert sock._get_next_message_id() == 0

= DICOMSocket _find_accepted_context_id lookup
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
assert sock._find_accepted_context_id("1.2.3") is None
sock.accepted_contexts = {1: (VERIFICATION_SOP_CLASS_UID, DEFAULT_TRANSFER_SYNTAX_UID)}
assert sock._find_accepted_context_id(VERIFICATION_SOP_CLASS_UID) == 1
assert sock._find_accepted_context_id(VERIFICATION_SOP_CLASS_UID, DEFAULT_TRANSFER_SYNTAX_UID) == 1
assert sock._find_accepted_context_id(VERIFICATION_SOP_CLASS_UID, "9.9.9") is None
assert sock._find_accepted_context_id("UNKNOWN") is None

= DICOMSocket guard clauses without association
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
assert sock.c_echo() is None
assert sock.c_store(b"d", "1.2.3", "1.2.3.4", DEFAULT_TRANSFER_SYNTAX_UID) is None
assert sock.release() is True
sock.close()
assert sock.sock is None and sock.stream is None

= DICOMSocket c_echo/c_store with association but no accepted context
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
sock.assoc_established = True
assert sock.c_echo() is None
assert sock.c_store(b"d", "1.2.3", "1.2.3.4", DEFAULT_TRANSFER_SYNTAX_UID) is None

= DICOMSocket connect failure on refused port returns False
sock = DICOMSocket("127.0.0.1", 1, "DEST_AE", read_timeout=1)
assert sock.connect() is False
assert sock.associate() is False

############
############
+ DICOMSocket with mock stream

= define mock stream and socket helpers
class _FakeSock:
    def __init__(self):
        self._sent = b""
    def sendall(self, data):
        self._sent += data
    def close(self):
        pass

class _FakeStream:
    def __init__(self):
        self.sent = []
        self.recv_responses = []
        self.closed = False
    def send(self, pkt):
        self.sent.append(bytes(pkt))
    def recv(self):
        return self.recv_responses.pop(0) if self.recv_responses else None
    def sr1(self, pkt, timeout=None, **kwargs):
        self.sent.append(bytes(pkt))
        return self.recv_responses.pop(0) if self.recv_responses else None
    def close(self):
        self.closed = True

assert _FakeStream is not None

= DICOMSocket send / recv / sr1 / send_raw_bytes / close
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
fake = _FakeStream()
sock.stream = fake
sock.sock = _FakeSock()
sock.send(DICOM() / A_RELEASE_RQ())
assert len(fake.sent) == 1
assert sock.recv() is None
fake.recv_responses.append(DICOM() / A_RELEASE_RP())
assert sock.recv().haslayer(A_RELEASE_RP)
fake.recv_responses.append(DICOM() / A_RELEASE_RP())
assert sock.sr1(DICOM() / A_RELEASE_RQ()).haslayer(A_RELEASE_RP)
sock.send_raw_bytes(b"raw_payload")
assert b"raw_payload" in sock.sock._sent
sock.close()
assert fake.closed and sock.stream is None

= DICOMSocket recv swallows socket errors
import socket as _stdsocket
class _TimeoutStream:
    def recv(self):
        raise _stdsocket.timeout()
    def close(self):
        pass

sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
sock.stream = _TimeoutStream()
assert sock.recv() is None

= DICOMSocket associate succeeds with mock A-ASSOCIATE-AC
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE", src_ae="SCAPY_SCU")
ts = DICOMVariableItem() / DICOMTransferSyntax(uid=_uid_to_bytes(DEFAULT_TRANSFER_SYNTAX_UID))
pctx = DICOMVariableItem() / DICOMPresentationContextAC(context_id=1, result=0, sub_items=[ts])
max_len = DICOMVariableItem() / DICOMMaximumLength(max_pdu_length=4096)
user_info = DICOMVariableItem() / DICOMUserInformation(sub_items=[max_len])
ac = DICOM(bytes(DICOM() / A_ASSOCIATE_AC(called_ae_title=b"DEST_AE", calling_ae_title=b"SCAPY_SCU", variable_items=[pctx, user_info])))
fake = _FakeStream()
fake.recv_responses.append(ac)
sock.stream = fake
sock.sock = _FakeSock()
assert sock.associate() is True
assert sock.assoc_established is True
assert 1 in sock.accepted_contexts
assert sock.max_pdu_length == 4096

= DICOMSocket associate fails on A-ASSOCIATE-RJ and on no response
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
rj = DICOM(bytes(DICOM() / A_ASSOCIATE_RJ(result=1, source=1, reason_diag=1)))
fake = _FakeStream()
fake.recv_responses.append(rj)
sock.stream = fake
sock.sock = _FakeSock()
assert sock.associate() is False
sock2 = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
sock2.stream = _FakeStream()
sock2.sock = _FakeSock()
assert sock2.associate() is False

= DICOMSocket c_echo round-trip with mock response
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
sock.assoc_established = True
sock.accepted_contexts = {1: (VERIFICATION_SOP_CLASS_UID, DEFAULT_TRANSFER_SYNTAX_UID)}
echo_rsp = bytes(C_ECHO_RSP(message_id_responded=1, status=0x0000))
pdv = PresentationDataValueItem(context_id=1, data=echo_rsp, is_command=1, is_last=1)
resp = DICOM(bytes(DICOM() / P_DATA_TF(pdv_items=[pdv])))
fake = _FakeStream()
fake.recv_responses.append(resp)
sock.stream = fake
sock.sock = _FakeSock()
assert sock.c_echo() == 0x0000

= DICOMSocket c_echo returns None on missing or empty response
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
sock.assoc_established = True
sock.accepted_contexts = {1: (VERIFICATION_SOP_CLASS_UID, DEFAULT_TRANSFER_SYNTAX_UID)}
sock.stream = _FakeStream()
sock.sock = _FakeSock()
assert sock.c_echo() is None
sock.stream.recv_responses.append(DICOM(bytes(DICOM() / P_DATA_TF(pdv_items=[]))))
assert sock.c_echo() is None

= DICOMSocket c_store single-PDU and fragmented transfers
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
sock.assoc_established = True
sock.accepted_contexts = {3: (CT_IMAGE_STORAGE_SOP_CLASS_UID, DEFAULT_TRANSFER_SYNTAX_UID)}
sock.max_pdu_length = 16384
store_rsp = bytes(C_STORE_RSP(message_id_responded=1, status=0x0000))
pdv = PresentationDataValueItem(context_id=3, data=store_rsp, is_command=1, is_last=1)
resp = DICOM(bytes(DICOM() / P_DATA_TF(pdv_items=[pdv])))
fake = _FakeStream()
fake.recv_responses.append(resp)
sock.stream = fake
sock.sock = _FakeSock()
assert sock.c_store(b"X" * 100, CT_IMAGE_STORAGE_SOP_CLASS_UID, "1.2.3.4", DEFAULT_TRANSFER_SYNTAX_UID) == 0x0000
sock.max_pdu_length = 1024
fake2 = _FakeStream()
fake2.recv_responses.append(DICOM(bytes(DICOM() / P_DATA_TF(pdv_items=[pdv]))))
sock.stream = fake2
assert sock.c_store(b"Y" * 5000, CT_IMAGE_STORAGE_SOP_CLASS_UID, "1.2.3.4", DEFAULT_TRANSFER_SYNTAX_UID) == 0x0000
assert len(fake2.sent) > 2

= DICOMSocket c_store returns None on missing response
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
sock.assoc_established = True
sock.accepted_contexts = {3: (CT_IMAGE_STORAGE_SOP_CLASS_UID, DEFAULT_TRANSFER_SYNTAX_UID)}
sock.stream = _FakeStream()
sock.sock = _FakeSock()
assert sock.c_store(b"X" * 10, CT_IMAGE_STORAGE_SOP_CLASS_UID, "1.2.3.4", DEFAULT_TRANSFER_SYNTAX_UID) is None

= DICOMSocket release with mock A-RELEASE-RP
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
sock.assoc_established = True
fake = _FakeStream()
fake.recv_responses.append(DICOM(bytes(DICOM() / A_RELEASE_RP())))
sock.stream = fake
sock.sock = _FakeSock()
assert sock.release() is True
sock2 = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
sock2.assoc_established = True
sock2.stream = _FakeStream()
sock2.sock = _FakeSock()
assert sock2.release() is False

= DICOMSocket _parse_max_pdu_length and _parse_accepted_contexts
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
sock._proposed_max_pdu = 16384
ml = DICOMVariableItem() / DICOMMaximumLength(max_pdu_length=8192)
ui = DICOMVariableItem() / DICOMUserInformation(sub_items=[ml])
ac = DICOM(bytes(DICOM() / A_ASSOCIATE_AC(called_ae_title=b"A", calling_ae_title=b"B", variable_items=[ui])))
sock._parse_max_pdu_length(ac)
assert sock.max_pdu_length == 8192
sock._parse_max_pdu_length(DICOM(bytes(DICOM() / A_ASSOCIATE_RJ())))
assert sock.max_pdu_length == 16384
sock._proposed_context_map = {1: VERIFICATION_SOP_CLASS_UID}
ts = DICOMVariableItem() / DICOMTransferSyntax(uid=_uid_to_bytes(DEFAULT_TRANSFER_SYNTAX_UID))
pctx = DICOMVariableItem() / DICOMPresentationContextAC(context_id=1, result=0, sub_items=[ts])
ac2 = DICOM(bytes(DICOM() / A_ASSOCIATE_AC(called_ae_title=b"A", calling_ae_title=b"B", variable_items=[pctx])))
sock._parse_accepted_contexts(ac2)
assert sock.accepted_contexts[1] == (VERIFICATION_SOP_CLASS_UID, DEFAULT_TRANSFER_SYNTAX_UID)
rej = DICOMVariableItem() / DICOMPresentationContextAC(context_id=1, result=3, sub_items=[ts])
ac3 = DICOM(bytes(DICOM() / A_ASSOCIATE_AC(called_ae_title=b"A", calling_ae_title=b"B", variable_items=[rej])))
sock.accepted_contexts = {}
sock._parse_accepted_contexts(ac3)
assert 1 not in sock.accepted_contexts

= DICOMSocket context manager exit
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
sock.assoc_established = True
fake = _FakeStream()
fake.recv_responses.append(DICOM(bytes(DICOM() / A_RELEASE_RP())))
sock.stream = fake
sock.sock = _FakeSock()
exit_result = sock.__exit__(None, None, None)
assert exit_result is False
assert sock.stream is None and sock.assoc_established is False
