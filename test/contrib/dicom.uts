+ DICOMSocket c_echo / c_store / release with mock stream

= c_echo with successful round-trip
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
sock.assoc_established = True
sock.accepted_contexts = {1: (VERIFICATION_SOP_CLASS_UID, DEFAULT_TRANSFER_SYNTAX_UID)}

# Build a fake response: a P-DATA-TF containing a C-ECHO-RSP with status=0x0000
echo_rsp_bytes = bytes(C_ECHO_RSP(message_id_responded=42, status=0x0000))
pdv_rsp = PresentationDataValueItem(
    context_id=1, data=echo_rsp_bytes, is_command=1, is_last=1
)
pdata_rsp = DICOM() / P_DATA_TF(pdv_items=[pdv_rsp])
pdata_rsp = DICOM(bytes(pdata_rsp))

fake = _FakeStream()
fake.recv_responses.append(pdata_rsp)
sock.stream = fake
sock.sock = _FakeSock()

status = sock.c_echo()
assert status == 0x0000

