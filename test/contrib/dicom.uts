############
+ parse_dimse_status tests

= parse_dimse_status extracts status from C_ECHO_RSP bytes
rsp = C_ECHO_RSP(message_id_responded=1, status=0x0000)
raw = bytes(rsp)
status = parse_dimse_status(raw)
assert status == 0x0000

= parse_dimse_status extracts non-zero status
rsp = C_ECHO_RSP(message_id_responded=1, status=0x0122)
raw = bytes(rsp)
status = parse_dimse_status(raw)
assert status == 0x0122

= parse_dimse_status returns None for truncated input
assert parse_dimse_status(b'\x00' * 4) is None

############
############
+ Edge cases

= Empty variable items list
pkt = DICOM() / A_ASSOCIATE_RQ(variable_items=[])
serialized = bytes(pkt)
parsed = DICOM(serialized)
assert parsed.haslayer(A_ASSOCIATE_RQ)

