= c_store sends data PDV when dataset fits in one PDU
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
sock.assoc_established = True
sock.accepted_contexts = {
    3: (CT_IMAGE_STORAGE_SOP_CLASS_UID, DEFAULT_TRANSFER_SYNTAX_UID),
}
sock.max_pdu_length = 16384
store_rsp_bytes = bytes(C_STORE_RSP(
    message_id_responded=43,
    status=0x0000,
    affected_sop_instance_uid="1.2.3.4.5.6.7.8.9",
))
pdv_rsp = PresentationDataValueItem(
    context_id=3, data=store_rsp_bytes, is_command=1, is_last=1
)
pdata_rsp = DICOM() / P_DATA_TF(pdv_items=[pdv_rsp])
pdata_rsp = DICOM(bytes(pdata_rsp))
fake = _FakeStream()
fake.recv_responses.append(pdata_rsp)
sock.stream = fake
sock.sock = _FakeSock()

status = sock.c_store(
    dataset_bytes=b"X" * 100,
    sop_class_uid=CT_IMAGE_STORAGE_SOP_CLASS_UID,
    sop_instance_uid="1.2.3.4.5.6.7.8.9",
    transfer_syntax_uid=DEFAULT_TRANSFER_SYNTAX_UID,
)
assert status == 0x0000
# Verify command + data PDV were sent
assert len(fake.sent) == 2

= c_store fragments large dataset across multiple PDUs
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
sock.assoc_established = True
sock.accepted_contexts = {
    3: (CT_IMAGE_STORAGE_SOP_CLASS_UID, DEFAULT_TRANSFER_SYNTAX_UID),
}
sock.max_pdu_length = 1024  # small PDU to force fragmentation
store_rsp_bytes = bytes(C_STORE_RSP(
    message_id_responded=44,
    status=0x0000,
))
