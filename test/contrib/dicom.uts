+ Implementation Version Name field with bytes value

= DICOMImplementationVersionName stores and serializes bytes
ver = DICOMImplementationVersionName(name=b"SCAPY_V1")
assert ver.fields.get("name") == b"SCAPY_V1"
# Serialization should embed the bytes
raw = bytes(ver)
assert b"SCAPY_V1" in raw

= DICOMImplementationVersionName mysummary works with field bytes
ver = DICOMImplementationVersionName(name=b"DCMTK_364")
summary = ver.mysummary()
assert "ImplVersion" in summary
assert "DCMTK_364" in summary

############
############
+ DIMSEPacket post_build group length

= DIMSEPacket post_build prepends 12-byte group length element
pkt = C_ECHO_RQ(message_id=1)
raw = bytes(pkt)
# First 12 bytes: group length element (0000,0000) UL 4 + 4-byte length
group_tag = struct.unpack("<HH", raw[:4])[0:2]
assert group_tag == (0x0000, 0x0000)
value_len = struct.unpack("<I", raw[4:8])[0]
assert value_len == 4
declared_group_len = struct.unpack("<I", raw[8:12])[0]
remaining_len = len(raw) - 12
assert declared_group_len == remaining_len

