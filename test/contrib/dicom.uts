############
############
+ parse_dimse_status edge cases

= parse_dimse_status returns None when no status element present
echo_rq = bytes(C_ECHO_RQ(message_id=1))
# C-ECHO-RQ has no status element
assert parse_dimse_status(echo_rq) is None

= parse_dimse_status returns None for empty input
assert parse_dimse_status(b"") is None

= parse_dimse_status returns None for malformed group length
# Build header claiming huge group length
bad = struct.pack("<HHI", 0x0000, 0x0000, 4) + struct.pack("<I", 0xFFFFFFFF) + b""
result = parse_dimse_status(bad)
assert result is None

= parse_dimse_status returns None when status element value is truncated
# Build header indicating status element follows but with no value bytes
hdr = struct.pack("<HHI", 0x0000, 0x0000, 4) + struct.pack("<I", 10)
status_elem = struct.pack("<HHI", 0x0000, 0x0900, 2)
truncated = hdr + status_elem
result = parse_dimse_status(truncated)
assert result is None

= parse_dimse_status handles struct error gracefully
# Pass exactly 11 bytes (one less than minimum 12) by claiming length=4
broken = b"\x00\x00\x00\x00\x04\x00\x00\x00\xFF\xFF\xFF"
assert parse_dimse_status(broken) is None

############
############
+ DICOM PDU full round-trip integration

= Full A-ASSOCIATE-RQ round-trip with all field types
app_ctx = DICOMVariableItem() / DICOMApplicationContext()
pctx = build_presentation_context_rq(
    1, VERIFICATION_SOP_CLASS_UID, [DEFAULT_TRANSFER_SYNTAX_UID]
)
user_info = build_user_information(
    max_pdu_length=16384,
    implementation_class_uid="1.2.276.0.7230010.3.0.3.6.4",
    implementation_version="OFFIS_DCMTK_364",
)
assoc_rq = DICOM() / A_ASSOCIATE_RQ(
    called_ae_title=b"ANY-SCP",
    calling_ae_title=b"ECHOSCU",
    variable_items=[app_ctx, pctx, user_info],
)
raw = bytes(assoc_rq)
parsed = DICOM(raw)
assert parsed.haslayer(A_ASSOCIATE_RQ)
items = parsed[A_ASSOCIATE_RQ].variable_items
assert len(items) == 3
ui_item = items[2]
ui = ui_item[DICOMUserInformation]
types = [s.item_type for s in ui.sub_items]
assert 0x51 in types
assert 0x52 in types
assert 0x55 in types

############
############
+ DICOMSocket basic class behavior

= DICOMSocket init defaults
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE", src_ae="SRC_AE")
assert sock.dst_ip == "127.0.0.1"
assert sock.dst_port == 11112
assert sock.dst_ae == "DEST_AE"
assert sock.src_ae == "SRC_AE"
assert sock.sock is None
assert sock.stream is None
assert sock.assoc_established is False
assert sock.max_pdu_length == 16384
assert isinstance(sock.accepted_contexts, dict)
assert len(sock.accepted_contexts) == 0

= DICOMSocket _get_next_message_id increments and wraps
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
sock._current_message_id_counter = 100
assert sock._get_next_message_id() == 101
assert sock._get_next_message_id() == 102
sock._current_message_id_counter = 0xFFFF
# Wraps because of & 0xFFFF; but counter itself keeps growing
val = sock._get_next_message_id()
assert val == 0  # 0x10000 & 0xFFFF == 0

= DICOMSocket _find_accepted_context_id returns None when empty
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
assert sock._find_accepted_context_id("1.2.3") is None

= DICOMSocket _find_accepted_context_id finds matching abstract+transfer syntax
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
sock.accepted_contexts = {
    1: (VERIFICATION_SOP_CLASS_UID, DEFAULT_TRANSFER_SYNTAX_UID),
    3: (CT_IMAGE_STORAGE_SOP_CLASS_UID, EXPLICIT_VR_LITTLE_ENDIAN_UID),
}
assert sock._find_accepted_context_id(VERIFICATION_SOP_CLASS_UID) == 1
assert sock._find_accepted_context_id(CT_IMAGE_STORAGE_SOP_CLASS_UID) == 3
assert sock._find_accepted_context_id(
    CT_IMAGE_STORAGE_SOP_CLASS_UID, EXPLICIT_VR_LITTLE_ENDIAN_UID
) == 3
assert sock._find_accepted_context_id(
    CT_IMAGE_STORAGE_SOP_CLASS_UID, "1.2.3.4.5"
) is None
assert sock._find_accepted_context_id("UNKNOWN_SOP") is None

= DICOMSocket close handles stream=None gracefully
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
# Should not raise
sock.close()
assert sock.sock is None
assert sock.stream is None
assert sock.assoc_established is False

= DICOMSocket c_echo without association returns None
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
assert sock.c_echo() is None

= DICOMSocket c_store without association returns None
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
result = sock.c_store(b"data", "1.2.3", "1.2.3.4", DEFAULT_TRANSFER_SYNTAX_UID)
assert result is None

= DICOMSocket release without association returns True
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
assert sock.release() is True

= DICOMSocket c_echo with association but no accepted context returns None
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
sock.assoc_established = True
# accepted_contexts is empty so verification context lookup fails
assert sock.c_echo() is None

= DICOMSocket c_store with association but no accepted context returns None
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
sock.assoc_established = True
result = sock.c_store(b"data", "1.2.3", "1.2.3.4", DEFAULT_TRANSFER_SYNTAX_UID)
assert result is None

= DICOMSocket connect failure returns False
# Use a port that should refuse connection (port 1 typically unused/restricted)
sock = DICOMSocket("127.0.0.1", 1, "DEST_AE", read_timeout=1)
result = sock.connect()
# Either connection refused or some other error; either way returns False
assert result is False

= DICOMSocket context manager basic flow
with DICOMSocket("127.0.0.1", 11112, "DEST_AE") as s:
    assert s.dst_ip == "127.0.0.1"
# Should not raise on exit even without association

= DICOMSocket associate without connect attempts connect and fails
sock = DICOMSocket("127.0.0.1", 1, "DEST_AE", read_timeout=1)
result = sock.associate()
assert result is False

############
############
+ DICOMSocket parsing helpers with mock responses

= _parse_max_pdu_length picks min of proposed and server values
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
sock._proposed_max_pdu = 16384
# Build a fake A-ASSOCIATE-AC with a UserInformation containing MaximumLength=8192
max_len_item = DICOMVariableItem() / DICOMMaximumLength(max_pdu_length=8192)
user_info = DICOMVariableItem() / DICOMUserInformation(sub_items=[max_len_item])
ac = DICOM() / A_ASSOCIATE_AC(
    called_ae_title=b"ANY",
    calling_ae_title=b"SRC",
    variable_items=[user_info],
)
# Reparse so layers are bound correctly
ac = DICOM(bytes(ac))
sock._parse_max_pdu_length(ac)
assert sock.max_pdu_length == 8192

= _parse_max_pdu_length picks proposed when server is larger
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
sock._proposed_max_pdu = 4096
max_len_item = DICOMVariableItem() / DICOMMaximumLength(max_pdu_length=65536)
user_info = DICOMVariableItem() / DICOMUserInformation(sub_items=[max_len_item])
ac = DICOM() / A_ASSOCIATE_AC(
    called_ae_title=b"ANY",
    calling_ae_title=b"SRC",
    variable_items=[user_info],
)
ac = DICOM(bytes(ac))
sock._parse_max_pdu_length(ac)
assert sock.max_pdu_length == 4096

= _parse_max_pdu_length falls back to proposed when no UserInfo
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
sock._proposed_max_pdu = 16384
ac = DICOM() / A_ASSOCIATE_AC(
    called_ae_title=b"ANY",
    calling_ae_title=b"SRC",
    variable_items=[],
)
ac = DICOM(bytes(ac))
sock._parse_max_pdu_length(ac)
assert sock.max_pdu_length == 16384

= _parse_accepted_contexts captures accepted presentation context
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
sock._proposed_context_map = {1: VERIFICATION_SOP_CLASS_UID}
ts = DICOMVariableItem() / DICOMTransferSyntax(
    uid=_uid_to_bytes(DEFAULT_TRANSFER_SYNTAX_UID)
)
pctx = DICOMVariableItem() / DICOMPresentationContextAC(
    context_id=1, result=0, sub_items=[ts]
)
ac = DICOM() / A_ASSOCIATE_AC(
    called_ae_title=b"ANY",
    calling_ae_title=b"SRC",
    variable_items=[pctx],
)
ac = DICOM(bytes(ac))
sock._parse_accepted_contexts(ac)
assert 1 in sock.accepted_contexts
abs_syn, ts_syn = sock.accepted_contexts[1]
assert abs_syn == VERIFICATION_SOP_CLASS_UID
assert ts_syn == DEFAULT_TRANSFER_SYNTAX_UID

= _parse_accepted_contexts skips rejected presentation contexts
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
sock._proposed_context_map = {1: VERIFICATION_SOP_CLASS_UID}
ts = DICOMVariableItem() / DICOMTransferSyntax(
    uid=_uid_to_bytes(DEFAULT_TRANSFER_SYNTAX_UID)
)
# result=3 means abstract syntax not supported
pctx = DICOMVariableItem() / DICOMPresentationContextAC(
    context_id=1, result=3, sub_items=[ts]
)
ac = DICOM() / A_ASSOCIATE_AC(
    called_ae_title=b"ANY",
    calling_ae_title=b"SRC",
    variable_items=[pctx],
)
ac = DICOM(bytes(ac))
sock._parse_accepted_contexts(ac)
assert 1 not in sock.accepted_contexts

= _parse_accepted_contexts skips contexts with unknown context_id
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
# Server returns context_id=5 that we did not propose
sock._proposed_context_map = {1: VERIFICATION_SOP_CLASS_UID}
ts = DICOMVariableItem() / DICOMTransferSyntax(
    uid=_uid_to_bytes(DEFAULT_TRANSFER_SYNTAX_UID)
)
pctx = DICOMVariableItem() / DICOMPresentationContextAC(
    context_id=5, result=0, sub_items=[ts]
)
ac = DICOM() / A_ASSOCIATE_AC(
    called_ae_title=b"ANY",
    calling_ae_title=b"SRC",
    variable_items=[pctx],
)
ac = DICOM(bytes(ac))
sock._parse_accepted_contexts(ac)
assert 5 not in sock.accepted_contexts

############
############
+ DIMSE response answers wrong RQ type

= C_FIND_RSP answers with matching message_id
rq = C_FIND_RQ(message_id=77)
rsp = C_FIND_RSP(message_id_responded=77)
assert rsp.answers(rq) == True
rsp_bad = C_FIND_RSP(message_id_responded=99)
assert rsp_bad.answers(rq) == False

= C_FIND_RSP returns 0 for non-C_FIND_RQ
rsp = C_FIND_RSP(message_id_responded=1)
assert rsp.answers(C_ECHO_RQ(message_id=1)) == 0
assert rsp.answers(A_RELEASE_RQ()) == 0

= C_MOVE_RSP answers with matching message_id
rq = C_MOVE_RQ(message_id=88)
rsp = C_MOVE_RSP(message_id_responded=88)
assert rsp.answers(rq) == True
rsp_bad = C_MOVE_RSP(message_id_responded=1)
assert rsp_bad.answers(rq) == False

= C_MOVE_RSP returns 0 for non-C_MOVE_RQ
rsp = C_MOVE_RSP(message_id_responded=1)
assert rsp.answers(C_ECHO_RQ(message_id=1)) == 0

= C_GET_RSP answers with matching message_id
rq = C_GET_RQ(message_id=88)
rsp = C_GET_RSP(message_id_responded=88)
assert rsp.answers(rq) == True
rsp_bad = C_GET_RSP(message_id_responded=1)
assert rsp_bad.answers(rq) == False

= C_GET_RSP returns 0 for non-C_GET_RQ
rsp = C_GET_RSP(message_id_responded=1)
assert rsp.answers(C_ECHO_RQ(message_id=1)) == 0

= N_GET_RSP returns 0 for non-N_GET_RQ
rsp = N_GET_RSP(message_id_responded=1)
assert rsp.answers(C_ECHO_RQ(message_id=1)) == 0

= N_SET_RSP returns 0 for non-N_SET_RQ
rsp = N_SET_RSP(message_id_responded=1)
assert rsp.answers(C_ECHO_RQ(message_id=1)) == 0

= N_ACTION_RSP returns 0 for non-N_ACTION_RQ
rsp = N_ACTION_RSP(message_id_responded=1)
assert rsp.answers(C_ECHO_RQ(message_id=1)) == 0

= N_DELETE_RSP returns 0 for non-N_DELETE_RQ
rsp = N_DELETE_RSP(message_id_responded=1)
assert rsp.answers(C_ECHO_RQ(message_id=1)) == 0

= C_ECHO_RSP returns 0 for non-C_ECHO_RQ
rsp = C_ECHO_RSP(message_id_responded=1)
assert rsp.answers(A_RELEASE_RQ()) == 0

