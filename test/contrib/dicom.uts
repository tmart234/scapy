    context_id=3, data=store_rsp_bytes, is_command=1, is_last=1
)
pdata_rsp = DICOM() / P_DATA_TF(pdv_items=[pdv_rsp])
pdata_rsp = DICOM(bytes(pdata_rsp))
fake = _FakeStream()
fake.recv_responses.append(pdata_rsp)
sock.stream = fake
sock.sock = _FakeSock()

# 5000-byte dataset needs ~5 fragments at 1012 bytes each
status = sock.c_store(
    dataset_bytes=b"Y" * 5000,
    sop_class_uid=CT_IMAGE_STORAGE_SOP_CLASS_UID,
    sop_instance_uid="1.2.3.4.5.6.7.8.9",
    transfer_syntax_uid=DEFAULT_TRANSFER_SYNTAX_UID,
)
assert status == 0x0000
