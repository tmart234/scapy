pkt = DICOMVariableItem() / DICOMAsyncOperationsWindow(
    max_ops_invoked=8,
    max_ops_performed=4
)
raw = bytes(pkt)
parsed = DICOMVariableItem(raw)
assert parsed[DICOMAsyncOperationsWindow].max_ops_invoked == 8
assert parsed[DICOMAsyncOperationsWindow].max_ops_performed == 4

