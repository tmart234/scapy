+ DICOMSocket without I/O

= DICOMSocket init defaults and helpers
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE", src_ae="SRC_AE")
assert sock.dst_ip == "127.0.0.1" and sock.dst_port == 11112
assert sock.dst_ae == "DEST_AE" and sock.src_ae == "SRC_AE"
