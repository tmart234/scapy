############
+ DICOMSocket context manager with established association

= __exit__ calls release() when assoc_established is True
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
sock.assoc_established = True
rp = DICOM() / A_RELEASE_RP()
rp = DICOM(bytes(rp))
fake = _FakeStream()
fake.recv_responses.append(rp)
sock.stream = fake
sock.sock = _FakeSock()
# Manually invoke __exit__ via with statement equivalent
exit_result = sock.__exit__(None, None, None)
assert exit_result is False
# release should have closed connection
assert sock.stream is None
assert sock.assoc_established is False

= __exit__ swallows release errors
sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
sock.assoc_established = True
class _BadStream:
    def sr1(self, pkt, timeout=None, **kwargs):
        raise _stdsocket.error("simulated release failure")
    def close(self):
        pass

sock.stream = _BadStream()
sock.sock = _FakeSock()
# Should not raise even though release raises
exit_result = sock.__exit__(None, None, None)
assert exit_result is False

############
############
+ DICOMSocket connect with mocked socket

= connect creates StreamSocket on successful socket.create_connection
import socket as _stdsocket2

_orig_create = _stdsocket2.create_connection
class _ConnectedSock:
    def __init__(self):
        self._buf = b""
    def recv(self, n=4096):
        return b""
    def send(self, data):
        self._buf += data
        return len(data)
    def sendall(self, data):
        self._buf += data
    def fileno(self):
        return -1
    def close(self):
        pass
    def settimeout(self, t):
        pass
    def gettimeout(self):
        return None

def _fake_create(addr, timeout=None):
    return _ConnectedSock()

_stdsocket2.create_connection = _fake_create
try:
    sock = DICOMSocket("127.0.0.1", 11112, "DEST_AE")
    result = sock.connect()
    assert result is True
    assert sock.sock is not None
    assert sock.stream is not None
finally:
    _stdsocket2.create_connection = _orig_create

= __exit__ catches socket.error raised from release
class _FakeSocketNoErr:
    def sendall(self, data): pass
    def close(self): pass

class _DICOMSocketReleaseRaises(DICOMSocket):
    def release(self):
        raise _stdsocket.error("simulated release error")

sock = _DICOMSocketReleaseRaises("127.0.0.1", 11112, "DEST_AE")
sock.assoc_established = True
sock.sock = _FakeSocketNoErr()
# Should not propagate exception
exit_result = sock.__exit__(None, None, None)
assert exit_result is False
