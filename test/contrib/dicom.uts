############
############
+ dimse_status_repr tests

= dimse_status_repr covers known codes and all PS3.7 ranges
assert "Success" in dimse_status_repr(0x0000)
assert "Cancel" in dimse_status_repr(0xFE00)
assert "Pending" in dimse_status_repr(0xFF00)
assert "Processing failure" in dimse_status_repr(0x0110)
# Service-class-specific Refused range 0xA000-0xAFFF
assert "service-class-specific" in dimse_status_repr(0xA500)
assert "Refused" in dimse_status_repr(0xA500)
# Service-class-specific Warning range 0xB000-0xBFFF
assert "service-class-specific" in dimse_status_repr(0xB500)
assert "Warning" in dimse_status_repr(0xB500)
# Unable-to-process range 0xC000-0xCFFF
assert "Unable to process" in dimse_status_repr(0xC500)
# Unknown code falls back to bare hex
assert dimse_status_repr(0x1234) == "0x1234"

