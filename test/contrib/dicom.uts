############
############
+ DIMSE-N packet tests

= N_EVENT_REPORT_RQ creation
pkt = N_EVENT_REPORT_RQ(
    affected_sop_class_uid="1.2.3",
    message_id=10,
    affected_sop_instance_uid="1.2.3.4",
    event_type_id=1
)
raw = bytes(pkt)
assert struct.pack("<H", 0x0100) in raw
assert b'1.2.3' in raw

= N_EVENT_REPORT_RSP answers N_EVENT_REPORT_RQ
rq = N_EVENT_REPORT_RQ(message_id=10)
rsp = N_EVENT_REPORT_RSP(message_id_responded=10)
assert rsp.answers(rq) == True
assert rsp.answers(C_ECHO_RQ(message_id=10)) == 0

= N_GET_RQ creation with empty attribute list
pkt = N_GET_RQ(
    requested_sop_class_uid="1.2.3",
    message_id=20,
    requested_sop_instance_uid="1.2.3.4",
    attribute_identifier_list=[]
)
raw = bytes(pkt)
assert struct.pack("<H", 0x0110) in raw

= N_GET_RQ with attribute identifier list
pkt = N_GET_RQ(
    requested_sop_class_uid="1.2.3",
    message_id=20,
    requested_sop_instance_uid="1.2.3.4",
    attribute_identifier_list=[(0x0010, 0x0010), (0x0010, 0x0020)]
)
raw = bytes(pkt)
# Verify the tag tuples are encoded as little-endian HH pairs
assert struct.pack("<HH", 0x0010, 0x0010) in raw
assert struct.pack("<HH", 0x0010, 0x0020) in raw

= N_GET_RSP answers N_GET_RQ
rq = N_GET_RQ(message_id=20)
rsp = N_GET_RSP(message_id_responded=20)
assert rsp.answers(rq) == True
rsp_bad = N_GET_RSP(message_id_responded=99)
assert rsp_bad.answers(rq) == False

= N_SET_RQ creation
pkt = N_SET_RQ(requested_sop_class_uid="1.2.3", message_id=30)
raw = bytes(pkt)
assert struct.pack("<H", 0x0120) in raw

= N_SET_RSP answers N_SET_RQ
rq = N_SET_RQ(message_id=30)
rsp = N_SET_RSP(message_id_responded=30)
assert rsp.answers(rq) == True

= N_ACTION_RQ creation with action_type_id
pkt = N_ACTION_RQ(
    requested_sop_class_uid="1.2.3",
    message_id=40,
    action_type_id=5
)
raw = bytes(pkt)
assert struct.pack("<H", 0x0130) in raw

= N_ACTION_RSP answers N_ACTION_RQ
rq = N_ACTION_RQ(message_id=40)
rsp = N_ACTION_RSP(message_id_responded=40)
assert rsp.answers(rq) == True

= N_CREATE_RQ creation
pkt = N_CREATE_RQ(affected_sop_class_uid="1.2.3", message_id=50)
raw = bytes(pkt)
assert struct.pack("<H", 0x0140) in raw

= N_CREATE_RSP answers N_CREATE_RQ
rq = N_CREATE_RQ(message_id=50)
rsp = N_CREATE_RSP(message_id_responded=50)
assert rsp.answers(rq) == True

= N_DELETE_RQ creation
pkt = N_DELETE_RQ(requested_sop_class_uid="1.2.3", message_id=60)
raw = bytes(pkt)
assert struct.pack("<H", 0x0150) in raw

= N_DELETE_RSP answers N_DELETE_RQ
rq = N_DELETE_RQ(message_id=60)
rsp = N_DELETE_RSP(message_id_responded=60)
assert rsp.answers(rq) == True

= DIMSE-N RSP does not answer wrong RQ type
rq = N_DELETE_RQ(message_id=60)
rsp = N_CREATE_RSP(message_id_responded=60)
assert rsp.answers(rq) == 0

############
############
+ DICOMATField tests

= DICOMATField encode empty list
pkt = N_GET_RQ(
    requested_sop_class_uid="1.2.3",
    message_id=1,
    attribute_identifier_list=[]
)
raw = bytes(pkt)
# Element (0000,1005) should be present with length 0
assert b'\x00\x00\x05\x10\x00\x00\x00\x00' in raw

= DICOMATField encode single tag tuple
pkt = N_GET_RQ(
    requested_sop_class_uid="1.2.3",
    message_id=1,
    attribute_identifier_list=[(0x0008, 0x0060)]
)
raw = bytes(pkt)
assert struct.pack("<HH", 0x0008, 0x0060) in raw

= DICOMATField encode integer tag
pkt = N_GET_RQ(
    requested_sop_class_uid="1.2.3",
    message_id=1,
    attribute_identifier_list=[0x00100010]
)
raw = bytes(pkt)
# Integer 0x00100010 should be split into group=0x0010, elem=0x0010
assert struct.pack("<HH", 0x0010, 0x0010) in raw

############
############
+ Helper function tests

= build_presentation_context_rq creates proper structure
pctx = build_presentation_context_rq(
    context_id=3,
    abstract_syntax_uid=VERIFICATION_SOP_CLASS_UID,
    transfer_syntax_uids=[DEFAULT_TRANSFER_SYNTAX_UID]
)
assert pctx.item_type == 0x20
assert pctx.haslayer(DICOMPresentationContextRQ)
assert pctx[DICOMPresentationContextRQ].context_id == 3
sub_items = pctx[DICOMPresentationContextRQ].sub_items
assert len(sub_items) == 2
assert sub_items[0].item_type == 0x30
assert sub_items[1].item_type == 0x40

= build_user_information creates proper structure
user_info = build_user_information(max_pdu_length=32768)
assert user_info.item_type == 0x50
assert user_info.haslayer(DICOMUserInformation)
sub_items = user_info[DICOMUserInformation].sub_items
assert len(sub_items) >= 1
assert sub_items[0].item_type == 0x51
assert sub_items[0][DICOMMaximumLength].max_pdu_length == 32768

= build_user_information with implementation info
user_info = build_user_information(
    max_pdu_length=16384,
    implementation_class_uid="1.2.3.4.5",
    implementation_version="SCAPY_V1"
)
sub_items = user_info[DICOMUserInformation].sub_items
assert len(sub_items) == 3
types = [item.item_type for item in sub_items]
assert 0x51 in types
assert 0x52 in types
assert 0x55 in types

= _uid_to_bytes pads odd-length UIDs
assert len(_uid_to_bytes("1.2.3")) % 2 == 0
assert _uid_to_bytes("1.2.3.4") == b"1.2.3.4\x00"
assert _uid_to_bytes("1.2.3") == b"1.2.3\x00"

