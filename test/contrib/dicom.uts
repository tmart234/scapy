pkt = DICOM() / P_DATA_TF(pdv_items=[])
serialized = bytes(pkt)
assert len(serialized) == 6

############
############
+ dimse_status_repr tests

= dimse_status_repr known status codes
assert "Success" in dimse_status_repr(0x0000)
assert "0x0000" in dimse_status_repr(0x0000)
assert "Cancel" in dimse_status_repr(0xFE00)
assert "Pending" in dimse_status_repr(0xFF00)
assert "Warning" in dimse_status_repr(0xFF01)
assert "SOP class not supported" in dimse_status_repr(0x0122)
assert "Processing failure" in dimse_status_repr(0x0110)
assert "Not authorized" in dimse_status_repr(0x0124)

= dimse_status_repr refused service-class-specific range (0xA000-0xAFFF)
result = dimse_status_repr(0xA500)
assert "Refused" in result
assert "service-class-specific" in result
assert "0xA500" in result
# Boundary: 0xA000 is in DIMSE_STATUS_CODES table, so 0xA001 is the start of fallback
result_low = dimse_status_repr(0xA001)
assert "service-class-specific" in result_low
result_high = dimse_status_repr(0xAFFF)
assert "service-class-specific" in result_high

= dimse_status_repr warning service-class-specific range (0xB000-0xBFFF)
result = dimse_status_repr(0xB500)
assert "Warning" in result
assert "service-class-specific" in result
assert "0xB500" in result
assert "service-class-specific" in dimse_status_repr(0xB000)
assert "service-class-specific" in dimse_status_repr(0xBFFF)

= dimse_status_repr unable-to-process range (0xC000-0xCFFF)
result = dimse_status_repr(0xC500)
assert "Unable to process" in result
assert "service-class-specific" in result
assert "0xC500" in result
assert "Unable to process" in dimse_status_repr(0xC000)
assert "Unable to process" in dimse_status_repr(0xCFFF)

= dimse_status_repr unknown code falls back to hex
result = dimse_status_repr(0x1234)
assert result == "0x1234"
result = dimse_status_repr(0xD000)
assert result == "0xD000"

############
############
+ UID conversion helper edge cases

= _uid_to_bytes with bytes input does not double-encode
assert _uid_to_bytes(b"1.2.3") == b"1.2.3\x00"
assert _uid_to_bytes(b"1.2.3.4") == b"1.2.3.4\x00"

= _uid_to_bytes with even-length input is not padded
assert _uid_to_bytes("1.2.3.4") == b"1.2.3.4\x00"
assert _uid_to_bytes(b"1234") == b"1234"
assert _uid_to_bytes("123456") == b"123456"

= _uid_to_bytes with unsupported type returns empty bytes
assert _uid_to_bytes(None) == b""
assert _uid_to_bytes(123) == b""
assert _uid_to_bytes([]) == b""

= _uid_to_bytes_raw does not pad
assert _uid_to_bytes_raw("1.2.3") == b"1.2.3"
assert _uid_to_bytes_raw(b"1.2.3") == b"1.2.3"
assert _uid_to_bytes_raw("1.2.3.4") == b"1.2.3.4"

= _uid_to_bytes_raw with unsupported type returns empty bytes
assert _uid_to_bytes_raw(None) == b""
assert _uid_to_bytes_raw(123) == b""
assert _uid_to_bytes_raw([1, 2]) == b""

############
############
+ DICOMAETitleField i2m / i2repr branches

= DICOMAETitleField i2m with None pads to 16 spaces
fld = DICOMAETitleField("ae")
assert fld.i2m(None, None) == b" " * 16

= DICOMAETitleField i2m with short string pads with spaces
fld = DICOMAETitleField("ae")
assert fld.i2m(None, "SCAPY") == b"SCAPY".ljust(16, b" ")

= DICOMAETitleField i2m with string longer than 16 is truncated
fld = DICOMAETitleField("ae")
assert fld.i2m(None, "A" * 32) == b"A" * 16

= DICOMAETitleField i2m with bytes input
fld = DICOMAETitleField("ae")
assert fld.i2m(None, b"AE") == b"AE".ljust(16, b" ")

= DICOMAETitleField i2repr decodes bytes and strips trailing spaces
fld = DICOMAETitleField("ae")
assert fld.i2repr(None, b"SCU             ") == "SCU"

= DICOMAETitleField i2repr handles malformed bytes
fld = DICOMAETitleField("ae")
result = fld.i2repr(None, b"\xff\xfeSCU")
assert isinstance(result, str)

= DICOMAETitleField i2repr handles non-bytes input
fld = DICOMAETitleField("ae")
assert fld.i2repr(None, "ABC   ") == "ABC"

############
############
+ DICOMElementField branches

= DICOMElementField addfield with None value writes zero-length element
fld = DICOMElementField("test", b"", 0x0010, 0x0020)
result = fld.addfield(None, b"", None)
# tag_group=0x0010, tag_elem=0x0020, length=0
assert result == struct.pack("<HHI", 0x0010, 0x0020, 0)

= DICOMElementField addfield with str value encodes to ascii
fld = DICOMElementField("test", b"", 0x0010, 0x0020)
result = fld.addfield(None, b"", "hello")
assert result == struct.pack("<HHI", 0x0010, 0x0020, 5) + b"hello"

= DICOMElementField getfield returns empty when buffer too small
fld = DICOMElementField("test", b"", 0x0010, 0x0020)
remain, val = fld.getfield(None, b"\x00\x00\x00")
assert val == b""
assert remain == b"\x00\x00\x00"

= DICOMElementField getfield raises when declared length exceeds buffer
fld = DICOMElementField("test", b"", 0x0010, 0x0020)
# Header declares length 100 but only 4 bytes of value follow
malformed = struct.pack("<HHI", 0x0010, 0x0020, 100) + b"abcd"
try:
    fld.getfield(None, malformed)
    assert False, "Should have raised Scapy_Exception"
except Scapy_Exception:
    pass

= DICOMElementField i2repr decodes ascii bytes
fld = DICOMElementField("test", b"", 0x0010, 0x0020)
assert fld.i2repr(None, b"VALUE\x00") == "VALUE"

= DICOMElementField i2repr falls back to hex for non-ascii bytes
fld = DICOMElementField("test", b"", 0x0010, 0x0020)
result = fld.i2repr(None, b"\xff\xfe\xfd")
assert result == "fffefd"

= DICOMElementField i2repr handles non-bytes input
fld = DICOMElementField("test", b"", 0x0010, 0x0020)
assert fld.i2repr(None, 42) == "42"

= DICOMElementField randval returns RandString
fld = DICOMElementField("test", b"", 0x0010, 0x0020)
rv = fld.randval()
assert rv is not None
# Should be able to materialize a value from it
materialized = bytes(rv)
assert len(materialized) == 8

############
############
+ DICOMUIDField branches

= DICOMUIDField addfield with empty value
fld = DICOMUIDField("test", b"", 0x0010, 0x0020)
result = fld.addfield(None, b"", b"")
# Empty value: length 0
assert result == struct.pack("<HHI", 0x0010, 0x0020, 0)

= DICOMUIDField i2repr handles non-bytes input
fld = DICOMUIDField("test", b"", 0x0010, 0x0020)
assert fld.i2repr(None, "1.2.3") == "1.2.3"

= DICOMUIDField i2repr handles malformed bytes
fld = DICOMUIDField("test", b"", 0x0010, 0x0020)
result = fld.i2repr(None, b'\xff\xfe\xfd')
assert isinstance(result, str)

= DICOMUIDField randval returns valid UID structure
fld = DICOMUIDField("test", b"", 0x0010, 0x0020)
rv = fld.randval()
# Returns a string starting with "1.2.3."
assert isinstance(rv, str)
assert rv.startswith("1.2.3.")

############
############
+ DICOMUIDFieldRaw branches

= DICOMUIDFieldRaw does not pad odd-length UIDs
fld = DICOMUIDFieldRaw("test", b"", 0x0010, 0x0020)
result = fld.addfield(None, b"", "1.2.3")
assert result == struct.pack("<HHI", 0x0010, 0x0020, 5) + b"1.2.3"

= DICOMUIDFieldRaw with bytes input
fld = DICOMUIDFieldRaw("test", b"", 0x0010, 0x0020)
result = fld.addfield(None, b"", b"1.2.3.4.5")
assert result == struct.pack("<HHI", 0x0010, 0x0020, 9) + b"1.2.3.4.5"

= DICOMUIDFieldRaw with empty value
fld = DICOMUIDFieldRaw("test", b"", 0x0010, 0x0020)
result = fld.addfield(None, b"", b"")
assert result == struct.pack("<HHI", 0x0010, 0x0020, 0)

############
############
+ DICOMUSField branches

= DICOMUSField round-trip via getfield
fld = DICOMUSField("test", 0, 0x0010, 0x0020)
built = fld.addfield(None, b"", 0x1234)
remain, val = fld.getfield(None, built)
assert val == 0x1234
assert remain == b""

= DICOMUSField getfield returns zero when value bytes too short
fld = DICOMUSField("test", 0, 0x0010, 0x0020)
# Header says length=1 but only 1 byte value
malformed = struct.pack("<HHI", 0x0010, 0x0020, 1) + b"\x42"
remain, val = fld.getfield(None, malformed)
assert val == 0

= DICOMUSField i2repr formats as hex
fld = DICOMUSField("test", 0, 0x0010, 0x0020)
assert fld.i2repr(None, 0x1234) == "0x1234"
assert fld.i2repr(None, 0) == "0x0000"

= DICOMUSField randval returns RandShort
fld = DICOMUSField("test", 0, 0x0010, 0x0020)
rv = fld.randval()
assert rv is not None
val = int(rv)
assert 0 <= val < 0x10000

############
############
+ DICOMULField branches

= DICOMULField round-trip via getfield
fld = DICOMULField("test", 0, 0x0010, 0x0020)
built = fld.addfield(None, b"", 0xDEADBEEF)
remain, val = fld.getfield(None, built)
assert val == 0xDEADBEEF
assert remain == b""

= DICOMULField getfield returns zero when value bytes too short
fld = DICOMULField("test", 0, 0x0010, 0x0020)
# Header says length=2 but only 2 bytes value
malformed = struct.pack("<HHI", 0x0010, 0x0020, 2) + b"\x42\x43"
remain, val = fld.getfield(None, malformed)
assert val == 0

= DICOMULField randval returns RandInt
fld = DICOMULField("test", 0, 0x0010, 0x0020)
rv = fld.randval()
assert rv is not None
val = int(rv)
assert 0 <= val < 0x100000000

############
############
+ DICOMAEDIMSEField branches

= DICOMAEDIMSEField addfield with None pads to 16 spaces
fld = DICOMAEDIMSEField("test", b"", 0x0000, 0x0600)
result = fld.addfield(None, b"", None)
hdr = struct.pack("<HHI", 0x0000, 0x0600, 16)
assert result == hdr + b" " * 16

= DICOMAEDIMSEField addfield with str input pads with spaces
fld = DICOMAEDIMSEField("test", b"", 0x0000, 0x0600)
result = fld.addfield(None, b"", "DEST")
hdr = struct.pack("<HHI", 0x0000, 0x0600, 16)
assert result == hdr + b"DEST".ljust(16, b" ")

= DICOMAEDIMSEField i2repr strips bytes
fld = DICOMAEDIMSEField("test", b"", 0x0000, 0x0600)
assert fld.i2repr(None, b"DEST            ") == "DEST"

= DICOMAEDIMSEField i2repr handles malformed bytes
fld = DICOMAEDIMSEField("test", b"", 0x0000, 0x0600)
result = fld.i2repr(None, b"\xff\xfeDEST")
assert isinstance(result, str)

= DICOMAEDIMSEField i2repr handles non-bytes input
fld = DICOMAEDIMSEField("test", b"", 0x0000, 0x0600)
assert fld.i2repr(None, "DEST    ") == "DEST"

############
############
+ DICOMATField branches

= DICOMATField addfield with None writes zero-length element
fld = DICOMATField("test", [], 0x0000, 0x1005)
result = fld.addfield(None, b"", None)
assert result == struct.pack("<HHI", 0x0000, 0x1005, 0)

= DICOMATField addfield with single int coerces to list
fld = DICOMATField("test", [], 0x0000, 0x1005)
result = fld.addfield(None, b"", 0x00100010)
hdr = struct.pack("<HHI", 0x0000, 0x1005, 4)
assert result == hdr + struct.pack("<HH", 0x0010, 0x0010)

= DICOMATField getfield decodes multiple tags
pkt = N_GET_RQ(
    requested_sop_class_uid="1.2.3",
    message_id=1,
    requested_sop_instance_uid="1.2.3.4",
    attribute_identifier_list=[(0x0008, 0x0060), (0x0010, 0x0010), (0x0010, 0x0020)]
)
raw = bytes(pkt)
reparsed = N_GET_RQ(raw[12:])
assert reparsed.attribute_identifier_list == [(0x0008, 0x0060), (0x0010, 0x0010), (0x0010, 0x0020)]

= DICOMATField getfield with no tags returns empty list
fld = DICOMATField("test", [], 0x0000, 0x1005)
built = struct.pack("<HHI", 0x0000, 0x1005, 0)
remain, tags = fld.getfield(None, built)
assert tags == []
assert remain == b""

= DICOMATField randval returns empty list
fld = DICOMATField("test", [], 0x0000, 0x1005)
assert fld.randval() == []

