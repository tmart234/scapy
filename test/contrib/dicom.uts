############
############
+ DICOMSOPClassExtendedNegotiation round-trip

= DICOMSOPClassExtendedNegotiation builds and parses
inner = DICOMSOPClassExtendedNegotiation(
    sop_class_uid=b"1.2.840.10008.1.1",
    service_class_application_information=b"\x01\x02\x03\x04",
)
item = DICOMVariableItem() / inner
raw = bytes(item)
parsed = DICOMVariableItem(raw)
assert parsed.item_type == 0x56
assert parsed.haslayer(DICOMSOPClassExtendedNegotiation)
inner_parsed = parsed[DICOMSOPClassExtendedNegotiation]
assert inner_parsed.sop_class_uid == b"1.2.840.10008.1.1"
assert inner_parsed.service_class_application_information == b"\x01\x02\x03\x04"

