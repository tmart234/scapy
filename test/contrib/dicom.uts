+ DICOM extract_padding tests

= DICOM extract_padding returns full input when length is None
pkt = DICOM()
pkt.length = None
payload, remaining = pkt.extract_padding(b"abc")
assert payload == b"abc"
assert remaining == b""

= DICOMVariableItem extract_padding raises on truncated buffer
item = DICOMVariableItem()
item.length = 100
try:
    item.extract_padding(b"abc")
    assert False, "Should have raised Scapy_Exception"
except Scapy_Exception:
    pass

= DICOMVariableItem extract_padding returns input when length is None
item = DICOMVariableItem()
item.length = None
payload, remaining = item.extract_padding(b"abc")
assert payload == b"abc"
assert remaining == b""

